// Enums
enum MonitorStatus {
  Unknown
  Online
  Offline
}

enum CloudIncidentSeverity {
  Unknown
  Minor
  Major
  Critical
}

enum CloudIncidentStatus {
  Investigating
  Identified
  Monitoring
  Resolved
}

enum CloudStatusSourceType {
  StatusPage
  Rss
  Api
}

enum CustomerType {
  Enterprise
  Startup
  Individual
}

enum AlertType {
  MonitorDown
  CloudIncidentCritical
  CloudIncidentMajor
  MonitorRecovered
  HighLatency
  CertificateExpiring
  CertificateExpired
  CloudIncidentMinor
  ScheduledMaintenance
  IncidentResolved
  IntegrationError
  CloudImportFailure
  BackgroundJobFailure
  Test
}

enum AlertChannel {
  Email
  Webhook
}

enum NotificationChannelType {
  Email
  Slack
  Teams
  Discord
  Telegram
  Webhook
}

enum DependencyType {
  DependsOn
  RequiredBy
  Related
}

enum ImpactLevel {
  None
  Low
  Medium
  High
  Critical
}

enum SummaryFrequency {
  Instant
  Every15Min
  Hourly
  Daily
  Weekly
}

enum NotificationSeverity {
  Critical
  High
  Medium
  Low
}

enum EmailTemplateType {
  Compact
  Detailed
}

enum NotificationLanguage {
  Spanish
  English
}

enum CloudStatusEventType {
  IncidentCreated
  IncidentUpdated
  IncidentResolved
  CorrelationDetected
  ImpactDetected
  ProviderSynced
  ProviderSyncFailed
}

enum AutomationTriggerType {
  MonitorDown
