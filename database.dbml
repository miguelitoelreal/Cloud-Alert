// Cloud-Alert Database Schema
// Generated from MonitoringPlatform.Domain entities

Table Tenant {
  Id Guid [pk]
  Name string [not null]
  Slug string [not null, unique]
  CreatedAtUtc datetime [not null]
}

Table ApplicationUser {
  Id Guid [pk]
  FullName string [not null]
  TenantId Guid [not null]
  CreatedAt datetime [not null]
  UpdatedAt datetime [not null]
}

Table RefreshToken {
  Id Guid [pk]
  TokenHash string [not null, unique]
  ExpiresAt datetime [not null]
  CreatedAt datetime [not null]
  ReplacedByTokenHash string
  UserId Guid [not null]
}

Table TenantSettings {
  Id Guid [pk]
  TenantId Guid [unique, not null]
  SmtpHost string [not null]
  SmtpPort int [not null]
  SmtpUsername string [not null]
  SmtpPassword string [not null]
  SenderEmail string [not null]
  SenderName string [not null]
  UseSsl bool [not null]
  EmailEnabled bool [not null]
  EmailProvider string [not null]
  BrevoApiKey string [not null]
  CreatedAt datetime [not null]
  UpdatedAt datetime [not null]
}

Table TenantStatusPageSettings {
  Id Guid [pk]
  TenantId Guid [unique, not null]
  IsEnabled bool [not null]
  Slug string [not null, unique]
  Title string
  LogoUrl string
  PrimaryColor string
  ShowUptime bool [not null]
  ShowIncidents bool [not null]
  PublicDomain string
  IsDeleted bool [not null]
  DeletedAtUtc datetime
  CreatedByUserId Guid
  UpdatedByUserId Guid
  CreatedAt datetime [not null]
  UpdatedAt datetime [not null]
}

Table Monitor {
  Id Guid [pk]
  TenantId Guid [not null]
  Name string [not null]
  Url string [not null]
