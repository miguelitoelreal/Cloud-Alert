  Status enum [not null]
  StatusCode int
  ResponseTimeMs bigint
  DnsTimeMs bigint
  ConnectTimeMs bigint
  TlsTimeMs bigint
  TtfbTimeMs bigint
  CheckedAt datetime [not null]
  ErrorMessage string
}

Table ServiceDependency {
  Id Guid [pk]
  TenantId Guid [not null]
  SourceMonitorId Guid [not null]
