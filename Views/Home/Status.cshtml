<script>
    (() => {
        const refreshUrl = '@Url.Action("StatusSnapshot", "Home")';
        const serviceDetailBaseUrl = '@Url.Action("ServiceStatus", "Home")';
        const statusCards = document.getElementById('statusCards');
        const statusRefresh = document.getElementById('statusRefresh');
        const overviewTime = document.getElementById('overviewTime');
        const overviewText = document.getElementById('overviewText');
        const summarySources = document.getElementById('summarySources');
        const summaryHealthy = document.getElementById('summaryHealthy');
        const summaryAttention = document.getElementById('summaryAttention');

        function formatUtc(value) {
            const date = new Date(value);
            return `${date.toISOString().slice(11, 19)} UTC`;
        }

        function escapeHtml(value) {
            return value
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function renderCards(services) {
            statusCards.innerHTML = services.map(service => `
                <div class="col-md-6 col-xl-4">
                    <article class="status-service-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h5 mb-1">${escapeHtml(service.name)}</h3>
                                <p class="status-muted mb-0">Cobertura: ${escapeHtml(service.scope)}</p>
                            </div>
                            <span class="status-pill status-${escapeHtml(service.level)}">${escapeHtml(service.displayStatus)}</span>
                        </div>
                        <div class="status-metric-row">
                            <span>Fuente</span>
                            <strong>${escapeHtml(service.sourceLabel)}</strong>
                        </div>
                        <div class="status-metric-row">
                            <span>Actualizado</span>
                            <strong>${formatUtc(service.sourceUpdatedAtUtc)}</strong>
                        </div>
                        <p class="status-summary-copy mt-3 mb-0">${escapeHtml(service.summary)}</p>
                        <a class="status-source-link" href="${serviceDetailBaseUrl}?slug=${encodeURIComponent(service.slug)}">Ver detalles</a>
                    </article>
                </div>`).join('');
        }

        async function refreshStatus() {
            try {
                const response = await fetch(refreshUrl, {
                    headers: { 'X-Requested-With': 'fetch' },
                    cache: 'no-store'
                });

                if (!response.ok) {
                    return;
                }

                const snapshot = await response.json();
                summarySources.textContent = String(snapshot.services.length);
                summaryHealthy.textContent = String(snapshot.healthyCount);
                summaryAttention.textContent = String(snapshot.attentionCount);
                overviewTime.textContent = formatUtc(snapshot.lastCheckedAtUtc);
                overviewText.textContent = snapshot.overview;
                statusRefresh.textContent = `Ultimo refresh: ${new Date(snapshot.lastUpdatedAtUtc).toISOString().replace('T', ' ').slice(0, 19)} UTC`;
                renderCards(snapshot.services);
            } catch (error) {
                console.error('No se pudo actualizar el tablero de estado.', error);
            }
        }

        window.setInterval(refreshStatus, 3600000);

        // Variables globales para el modal de incidentes


        window.openIncidentModal = async function(id) {
            try {
                const response = await fetch(`/api/incidentes/${id}`, {
                    headers: { 'X-Requested-With': 'fetch' }
                });

                if (!response.ok) {
                    console.error('No se pudo cargar el incidente');
                    return;
                }

                const incidente = await response.json();

                // Traducir severidad
                const severidadMap = {
                    'Critica': 'CRÍTICA',
                    'Alta': 'ALTA',
                    'Media': 'MEDIA'
                };
                const severidadTraducida = severidadMap[incidente.severidad] || incidente.severidad;



                // Completar datos del modal
                // Traducir descripción automáticamente
                let descripcionFinal = incidente.descripcion;
                try {
                    const translateResponse = await fetch('/api/incidentes/translate', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'fetch'
                        },
                        body: JSON.stringify({
                            text: incidente.descripcion,
                            sourceLanguage: 'en',
                            targetLanguage: 'es'
                        })
                    });
                    
                    if (translateResponse.ok) {
                        const translateData = await translateResponse.json();
                        descripcionFinal = translateData.translatedText;
                    }
                } catch (error) {
                    console.warn('No se pudo traducir la descripción:', error);
                    // Se mantiene el texto original
                }

                document.getElementById('incidentModalLabel').textContent = incidente.titulo;
                document.getElementById('incidentModalSubtitle').textContent = incidente.codigo;
                document.getElementById('modalSeveridad').textContent = severidadTraducida;
                document.getElementById('modalEstado').textContent = 'Abierto';
                document.getElementById('modalServicio').textContent = incidente.servicio;
                document.getElementById('modalFecha').textContent = incidente.fecha;
                document.getElementById('modalDescripcion').textContent = descripcionFinal;
                

                document.getElementById('modalProveedor').textContent = incidente.proveedor;
                document.getElementById('modalUrlLink').href = incidente.urlDetalle || '#';
                document.getElementById('modalUrlLink').style.display = incidente.urlDetalle ? 'inline-block' : 'none';

                // Mostrar modal
                const modal = new bootstrap.Modal(document.getElementById('incidentModal'));
                modal.show();
            } catch (error) {
                console.error('Error al cargar el incidente:', error);
            }
        };

        window.downloadIncidentPDF = async function() {
            const titulo = document.getElementById('incidentModalLabel').textContent || 'Incidente';
            const codigo = document.getElementById('incidentModalSubtitle').textContent || '';
            const severidad = document.getElementById('modalSeveridad').textContent || '';
            const estado = document.getElementById('modalEstado').textContent || '';
            const servicio = document.getElementById('modalServicio').textContent || '';
            const fecha = document.getElementById('modalFecha').textContent || '';
            const descripcionOriginal = document.getElementById('modalDescripcion').textContent || '';
            const proveedor = document.getElementById('modalProveedor').textContent || '';

            // Traducir la descripción al descargar el PDF
            let descripcionFinal = descripcionOriginal;
            try {
                const response = await fetch('/api/incidentes/translate', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'fetch'
                    },
                    body: JSON.stringify({
                        text: descripcionOriginal,
                        sourceLanguage: 'en',
                        targetLanguage: 'es'
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    descripcionFinal = data.translatedText || descripcionOriginal;
                }
            } catch (error) {
                console.warn('No se pudo traducir la descripción para el PDF:', error);
                // Mantiene la descripción original si falla la traducción
            }

            // Crear resumen de descripción para el PDF (primeros 500 caracteres)
            if (descripcionFinal.length > 500) {
                descripcionFinal = descripcionFinal.substring(0, 500) + '...';
            }

            const htmlContent = `
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h1 style="color: #000; border-bottom: 2px solid #007bff; padding-bottom: 10px;">${titulo}</h1>
                    <p style="color: #000; font-size: 12px; margin-bottom: 20px;">Código: ${codigo}</p>

                    <div style="margin-bottom: 20px;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    <strong>Severidad:</strong>
                                </td>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    ${severidad}
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    <strong>Estado:</strong>
                                </td>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    ${estado}
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    <strong>Servicio:</strong>
                                </td>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    ${servicio}
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    <strong>Fecha:</strong>
                                </td>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    ${fecha}
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    <strong>Proveedor:</strong>
                                </td>
                                <td style="width: 50%; padding: 10px; border: 1px solid #ddd; color: #000;">
                                    ${proveedor}
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="margin-top: 20px;">
                        <h3 style="color: #000; margin-bottom: 10px;">Descripción</h3>
                        <p style="color: #000; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word;">${descripcionResumen}</p>
                    </div>

                    <div style="margin-top: 30px; padding-top: 10px; border-top: 1px solid #ddd; font-size: 12px; color: #000;">
                        <p>Generado el: ${new Date().toLocaleString('es-ES')}</p>
                    </div>
                </div>
            `;

            const options = {
                margin: 10,
                filename: `incidente_${codigo.replace(/\\s+/g, '_')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' }
            };

            if (typeof html2pdf !== 'undefined') {
                html2pdf().set(options).from(htmlContent).save();
            } else {
                alert('Error: Librería de PDF no cargada. Por favor, recarga la página.');
            }
        };
    })();
</script>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
}