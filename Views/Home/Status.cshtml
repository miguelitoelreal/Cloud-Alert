@using CloudAlertApp.Models

@model CloudAlertApp.Models.CloudStatusPageViewModel

@{
    ViewData["Title"] = "Estado Global";
}

<section class="status-hero py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="status-kicker">Monitoreo global</span>
                <h1 class="display-4 fw-bold mt-3 mb-3">Estado en vivo de los servicios cloud</h1>
                <p class="lead status-lead mb-4">
                    Vista publica del estado general usando fuentes oficiales. Para evitar ruido y consumo innecesario, este tablero se renueva cada 60 minutos.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="status-summary-card">
                        <span class="summary-label">Fuentes monitoreadas</span>
                        <strong id="summarySources">@Model.Services.Count</strong>
                    </div>
                    <div class="status-summary-card">
                        <span class="summary-label">Activos estables</span>
                        <strong id="summaryHealthy">@Model.HealthyCount</strong>
                    </div>
                    <div class="status-summary-card status-summary-attention">
                        <span class="summary-label">Requieren atencion</span>
                        <strong id="summaryAttention">@Model.AttentionCount</strong>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="status-overview-panel">
                    <div class="overview-header">
                        <span class="overview-dot"></span>
                        Actualizacion reciente
                    </div>
                    <div class="overview-time" id="overviewTime">@Model.LastCheckedAtUtc.ToUniversalTime().ToString("HH:mm:ss") UTC</div>
                    <p class="mb-0" id="overviewText">@Model.Overview</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="status-board">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h2 class="h3 fw-bold mb-1">Panel global</h2>
                    <p class="status-muted mb-0">Proveedores en vivo e incidentes activos monitoreados.</p>
                </div>
                <span class="status-refresh" id="statusRefresh">Ultimo refresh: @Model.LastUpdatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            </div>

            <div class="row g-4 mb-5" id="statusCards">
                @foreach (var servicio in Model.Services)
                {
                    <div class="col-md-6 col-xl-4">
                        <article class="status-service-card">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <h3 class="h5 mb-1">@servicio.Name</h3>
                                    <p class="status-muted mb-0">Cobertura: @servicio.Scope</p>
                                </div>
                                <span class="status-pill status-@servicio.Level">@servicio.DisplayStatus</span>
                            </div>

                            <div class="status-metric-row">
                                <span>Fuente</span>
                                <strong>@servicio.SourceLabel</strong>
                            </div>
                            <div class="status-metric-row">
                                <span>Actualizado</span>
                                <strong>@servicio.SourceUpdatedAtUtc.ToUniversalTime().ToString("HH:mm:ss") UTC</strong>
                            </div>
                            <p class="status-summary-copy mt-3 mb-0">@servicio.Summary</p>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a class="status-source-link" asp-controller="Home" asp-action="ServiceStatus" asp-route-slug="@servicio.Slug">Ver detalles</a>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h3 class="h4 fw-bold mb-1">Incidentes activos</h3>
                    <p class="status-muted mb-0">Eventos registrados internamente para seguimiento operativo.</p>
                </div>
            </div>

            @if (Model.Incidentes.Any())
            {
                <div class="incidents-list" id="incidentsList">
                    @foreach (var incidente in Model.Incidentes)
                    {
                        <div class="incident-card">
                            <div class="incident-header">
                                <div class="incident-icon severity-@(incidente.Severidad.ToString().ToLower())">
                                    @if (incidente.Severidad == Severidad.Critica)
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="8" x2="12" y2="12"></line>
                                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                        </svg>
                                    }
                                    else if (incidente.Severidad == Severidad.Alta)
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3.05h16.94a2 2 0 0 0 1.71-3.05L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                            <line x1="12" y1="9" x2="12" y2="13"></line>
                                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="16" x2="12" y2="12"></line>
                                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                        </svg>
                                    }
                                </div>
                                <div class="incident-title-section">
                                    <div class="incident-code-row">
                                        <span class="incident-code">@incidente.Codigo</span>
                                        <span class="service-badge">@incidente.NombreProveedor</span>
                                        <span class="severity-badge severity-@(incidente.Severidad.ToString().ToLower())">
                                            @if (incidente.Severidad == Severidad.Critica) { <text>CRÍTICA</text> }
                                            else if (incidente.Severidad == Severidad.Alta) { <text>ALTA</text> }
                                            else { <text>MEDIA</text> }
                                        </span>
                                        <span class="status-badge">@incidente.Estado</span>
                                    </div>
                                    <h3 class="incident-title">@incidente.Titulo</h3>
                                </div>
                                <div class="incident-actions">
                                    <button type="button" class="btn-details" onclick="openIncidentModal(@incidente.Id)">Ver Detalles</button>
                                </div>
                            </div>

                            <p class="incident-description">@incidente.Descripcion</p>

                            <div class="incident-metadata">
                                <div class="metadata-item">
                                    <span class="metadata-label">Fecha</span>
                                    <span class="metadata-value">@incidente.Fecha.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Servicio</span>
                                    <span class="metadata-value">@incidente.Servicio</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Proveedor</span>
                                    <span class="metadata-value">@incidente.NombreProveedor</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Asignado a</span>
                                    <span class="metadata-value">@incidente.AsignadoA</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-incidents-message">
                    <p class="status-muted">No hay incidentes activos en este momento.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Modal de Detalles del Incidente -->
<div class="modal fade" id="incidentModal" tabindex="-1" aria-labelledby="incidentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content incident-modal-content">
            <div class="modal-header incident-modal-header">
                <div>
                    <h5 class="modal-title" id="incidentModalLabel"></h5>
                    <small id="incidentModalSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body incident-modal-body">
                <div class="detail-row">
                    <div class="detail-col">
                        <label class="detail-label">Severidad</label>
                        <p id="modalSeveridad"></p>
                    </div>
                    <div class="detail-col">
                        <label class="detail-label">Estado</label>
                        <p id="modalEstado"></p>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-col">
                        <label class="detail-label">Servicio</label>
                        <p id="modalServicio"></p>
                    </div>
                    <div class="detail-col">
                        <label class="detail-label">Fecha</label>
                        <p id="modalFecha"></p>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-col full-width">
                        <label class="detail-label">Descripción</label>
                        <p id="modalDescripcion" style="max-height: 200px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;"></p>
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-col full-width">
                        <label class="detail-label">Proveedor</label>
                        <p id="modalProveedor"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" onclick="downloadIncidentPDF()">📥 Compartir</button>
                <a href="#" id="modalUrlLink" class="btn btn-primary" target="_blank">Ver más información</a>
            </div>
        </div>
    </div>
</div>

<style>
    .status-hero {
        position: relative;
    }

    .status-kicker {
        display: inline-block;
        padding: 0.45rem 0.85rem;
        border: 1px solid rgba(0, 230, 251, 0.3);
        border-radius: 999px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #7ee7f7;
        background: rgba(0, 230, 251, 0.08);
    }

    .status-lead {
        max-width: 60ch;
        color: rgba(224, 230, 237, 0.85);
    }

    .status-summary-card {
        min-width: 170px;
        padding: 1rem 1.1rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.95), rgba(35, 42, 61, 0.95));
        border: 1px solid rgba(0, 230, 251, 0.12);
        box-shadow: 0 18px 50px -30px rgba(0, 230, 251, 0.65);
    }

    .status-summary-card strong {
        display: block;
        font-size: 1.8rem;
        color: #ffffff;
    }

    .summary-label {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 0.82rem;
        color: rgba(224, 230, 237, 0.72);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .status-summary-attention {
        border-color: rgba(255, 193, 7, 0.25);
        box-shadow: 0 18px 50px -30px rgba(255, 193, 7, 0.45);
    }

    .status-overview-panel {
        padding: 1.5rem;
        border-radius: 1.25rem;
        background: radial-gradient(circle at top, rgba(0, 230, 251, 0.12), rgba(24, 28, 43, 0.94) 60%);
        border: 1px solid rgba(126, 231, 247, 0.18);
        box-shadow: 0 24px 60px -30px rgba(0, 230, 251, 0.5);
    }

    .overview-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.75rem;
        color: #7ee7f7;
        font-size: 0.92rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .overview-dot {
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 50%;
        background: #43e97b;
        box-shadow: 0 0 12px rgba(67, 233, 123, 0.8);
    }

    .overview-time {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 0.65rem;
    }

    .status-board {
        padding: 2rem;
        border-radius: 1.5rem;
        background: rgba(13, 17, 28, 0.82);
        border: 1px solid rgba(126, 231, 247, 0.12);
        box-shadow: 0 24px 60px -36px rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(12px);
    }

    .status-muted {
        color: rgba(224, 230, 237, 0.68);
    }

    .status-refresh {
        padding: 0.55rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(224, 230, 237, 0.8);
        font-size: 0.9rem;
    }

    .status-service-card {
        height: 100%;
        padding: 1.35rem;
        border-radius: 1.2rem;
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.95), rgba(18, 24, 38, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        flex-direction: column;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .status-success {
        background: rgba(67, 233, 123, 0.16);
        color: #8ef0ae;
    }

    .status-warning {
        background: rgba(255, 193, 7, 0.18);
        color: #ffd666;
    }

    .status-info {
        background: rgba(0, 180, 216, 0.18);
        color: #7ee7f7;
    }

    .status-danger {
        background: rgba(255, 91, 91, 0.18);
        color: #ff9f9f;
    }

    .status-metric-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.85rem;
        margin-top: 0.85rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .status-metric-row span {
        color: rgba(224, 230, 237, 0.7);
    }

    .status-metric-row strong {
        text-align: right;
    }

    .status-incident-text {
        max-width: 18ch;
    }

    .status-summary-copy {
        color: rgba(224, 230, 237, 0.84);
        line-height: 1.6;
        flex: 1 0 auto;
    }

    .status-source-link {
        display: inline-flex;
        margin-top: 1rem;
        color: #7ee7f7;
        text-decoration: none;
        font-weight: 600;
    }

    .status-source-link:hover {
        color: #ffffff;
    }

    body.light-mode .status-lead,
    body.light-mode .status-muted,
    body.light-mode .status-refresh,
    body.light-mode .status-metric-row span,
    body.light-mode .summary-label,
    body.light-mode .status-summary-copy {
        color: rgba(35, 42, 61, 0.72) !important;
    }

    body.light-mode .status-summary-card,
    body.light-mode .status-service-card,
    body.light-mode .status-board,
    body.light-mode .status-overview-panel {
        background: rgba(255, 255, 255, 0.92);
        border-color: rgba(0, 180, 216, 0.12);
        color: #232a3d;
    }

    body.light-mode .status-summary-card strong,
    body.light-mode .overview-time,
    body.light-mode .status-metric-row strong,
    body.light-mode .status-service-card h3,
    body.light-mode .status-board h2,
    body.light-mode .status-hero h1 {
        color: #232a3d !important;
    }

    /* Incident List Styles */
    .incidents-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .incident-card {
        padding: 1.5rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.95), rgba(18, 24, 38, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: border-color 0.3s ease;
    }

    .incident-card:hover {
        border-color: rgba(126, 231, 247, 0.3);
    }

    .incident-header {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .incident-icon {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.6rem;
        font-weight: 700;
    }

    .incident-icon.severity-critica {
        background: rgba(255, 91, 91, 0.2);
        color: #ff9f9f;
    }

    .incident-icon.severity-alta {
        background: rgba(255, 193, 7, 0.2);
        color: #ffd666;
    }

