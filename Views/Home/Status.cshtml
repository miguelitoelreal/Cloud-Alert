@using CloudAlertApp.Models

@model CloudAlertApp.Models.CloudStatusPageViewModel

@{
    ViewData["Title"] = "Estado Global";
}

<section class="status-hero py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="status-kicker">Monitoreo global</span>
                <h1 class="display-4 fw-bold mt-3 mb-3">Estado en vivo de los servicios cloud</h1>
                <p class="lead status-lead mb-4">
                    Vista publica del estado general usando fuentes oficiales. Para evitar ruido y consumo innecesario, este tablero se renueva cada 60 minutos.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="status-summary-card">
                        <span class="summary-label">Fuentes monitoreadas</span>
                        <strong id="summarySources">@Model.Services.Count</strong>
                    </div>
                    <div class="status-summary-card">
                        <span class="summary-label">Activos estables</span>
                        <strong id="summaryHealthy">@Model.HealthyCount</strong>
                    </div>
                    <div class="status-summary-card status-summary-attention">
                        <span class="summary-label">Requieren atencion</span>
                        <strong id="summaryAttention">@Model.AttentionCount</strong>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="status-overview-panel">
                    <div class="overview-header">
                        <span class="overview-dot"></span>
                        Actualizacion reciente
                    </div>
                    <div class="overview-time" id="overviewTime">@Model.LastCheckedAtUtc.ToUniversalTime().ToString("HH:mm:ss") UTC</div>
                    <p class="mb-0" id="overviewText">@Model.Overview</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="status-board">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h2 class="h3 fw-bold mb-1">Panel global</h2>
                    <p class="status-muted mb-0">Proveedores en vivo e incidentes activos monitoreados.</p>
                </div>
                <span class="status-refresh" id="statusRefresh">Ultimo refresh: @Model.LastUpdatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            </div>

            <div class="row g-4 mb-5" id="statusCards">
                @foreach (var servicio in Model.Services)
                {
                    <div class="col-md-6 col-xl-4">
                        <article class="status-service-card">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <h3 class="h5 mb-1">@servicio.Name</h3>
                                    <p class="status-muted mb-0">Cobertura: @servicio.Scope</p>
                                </div>
                                <span class="status-pill status-@servicio.Level">@servicio.DisplayStatus</span>
                            </div>

                            <div class="status-metric-row">
                                <span>Fuente</span>
                                <strong>@servicio.SourceLabel</strong>
                            </div>
                            <div class="status-metric-row">
                                <span>Actualizado</span>
                                <strong>@servicio.SourceUpdatedAtUtc.ToUniversalTime().ToString("HH:mm:ss") UTC</strong>
                            </div>
                            <p class="status-summary-copy mt-3 mb-0">@servicio.Summary</p>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button type="button" class="status-source-link" onclick="openServiceModal({
                                    name: '@servicio.Name',
                                    displayStatus: '@servicio.DisplayStatus',
                                    level: '@servicio.Level',
                                    scope: '@servicio.Scope',
                                    summary: '@servicio.Summary.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "")',
                                    sourceLabel: '@servicio.SourceLabel',
                                    sourceUrl: '@servicio.SourceUrl',
                                    sourceUpdatedAtUtc: '@servicio.SourceUpdatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")',
                                    description: '@servicio.Description.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "")',
                                    category: '@servicio.Category',
                                    daysWithoutIncidents: @servicio.DaysWithoutIncidents
                                })">Ver detalles</button>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Modal de Detalles del Incidente -->
<div class="modal fade" id="incidentModal" tabindex="-1" aria-labelledby="incidentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content incident-modal-content">
            <div class="modal-header incident-modal-header">
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="modal-title" id="incidentModalLabel"></h5>
                            <small id="incidentModalSubtitle"></small>
                        </div>
                    </div>
                    <div class="modal-badges d-flex gap-2 flex-wrap">
                        <span id="modalSeveridadBadge" class="severity-badge"></span>
                        <span id="modalEstadoBadge" class="status-badge">Abierto</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body incident-modal-body">
                <div class="detail-row">
                    <div class="detail-col">
                        <label class="detail-label">SEVERIDAD</label>
                        <p id="modalSeveridad" class="detail-value"></p>
                    </div>
                    <div class="detail-col">
                        <label class="detail-label">ESTADO</label>
                        <p id="modalEstado" class="detail-value"></p>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-col">
                        <label class="detail-label">SERVICIO</label>
                        <p id="modalServicio" class="detail-value"></p>
                    </div>
                    <div class="detail-col">
                        <label class="detail-label">FECHA</label>
                        <p id="modalFecha" class="detail-value"></p>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-col full-width">
                        <label class="detail-label">DESCRIPCIÓN</label>
                        <div id="modalDescripcion" class="detail-description-box"></div>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-col full-width">
                        <label class="detail-label">PROVEEDOR</label>
                        <p id="modalProveedor" class="detail-value"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="downloadIncidentPDF()">📥 Compartir</button>
                <a href="#" id="modalUrlLink" class="btn btn-info" target="_blank" style="display: none;">Ver más información</a>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Detalles del Servicio -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content incident-modal-content">
            <div class="modal-header incident-modal-header">
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="modal-title" id="serviceModalLabel"></h5>
                            <small id="serviceModalSubtitle"></small>
                        </div>
                    </div>
                    <div class="modal-badges d-flex gap-2 flex-wrap">
                        <span id="modalServiceStatusBadge" class="status-pill"></span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body incident-modal-body">
                <div class="detail-row">
                    <div class="detail-col">
                        <label class="detail-label">ESTADO</label>
                        <p id="modalServiceStatus" class="detail-value"></p>
                    </div>
                    <div class="detail-col">
                        <label class="detail-label">CATEGORÍA</label>
                        <p id="modalServiceCategory" class="detail-value"></p>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-col">
                        <label class="detail-label">COBERTURA</label>
                        <p id="modalServiceScope" class="detail-value"></p>
                    </div>
                    <div class="detail-col">
                        <label class="detail-label">DÍAS SIN INCIDENTES</label>
                        <p id="modalServiceDays" class="detail-value"></p>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-col full-width">
                        <label class="detail-label">DESCRIPCIÓN</label>
                        <div id="modalServiceDescription" class="detail-description-box"></div>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-col full-width">
                        <label class="detail-label">INFORMACIÓN</label>
                        <div style="border-left: 3px solid #7ee7f7; padding-left: 1rem;">
                            <p class="detail-value" style="margin-bottom: 0.5rem;"><strong>Fuente:</strong> <span id="modalServiceSource"></span></p>
                            <p class="detail-value"><strong>Actualizado:</strong> <span id="modalServiceUpdated"></span></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="downloadServicePDF()">📥 Compartir</button>
                <a href="#" id="modalServiceUrlLink" class="btn btn-info" target="_blank">Ver fuente oficial</a>
            </div>
        </div>
    </div>
</div>

<style>
    .status-hero {
        position: relative;
    }

    .status-kicker {
        display: inline-block;
        padding: 0.45rem 0.85rem;
        border: 1px solid rgba(0, 230, 251, 0.3);
        border-radius: 999px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #7ee7f7;
        background: rgba(0, 230, 251, 0.08);
    }

    .status-lead {
        max-width: 60ch;
        color: rgba(224, 230, 237, 0.85);
    }

    .status-summary-card {
        min-width: 170px;
        padding: 1rem 1.1rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.95), rgba(35, 42, 61, 0.95));
        border: 1px solid rgba(0, 230, 251, 0.12);
        box-shadow: 0 18px 50px -30px rgba(0, 230, 251, 0.65);
    }

    .status-summary-card strong {
        display: block;
        font-size: 1.8rem;
        color: #ffffff;
    }

    .summary-label {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 0.82rem;
        color: rgba(224, 230, 237, 0.72);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .status-summary-attention {
        border-color: rgba(255, 193, 7, 0.25);
        box-shadow: 0 18px 50px -30px rgba(255, 193, 7, 0.45);
    }

    .status-overview-panel {
        padding: 1.5rem;
        border-radius: 1.25rem;
        background: radial-gradient(circle at top, rgba(0, 230, 251, 0.12), rgba(24, 28, 43, 0.94) 60%);
        border: 1px solid rgba(126, 231, 247, 0.18);
        box-shadow: 0 24px 60px -30px rgba(0, 230, 251, 0.5);
    }

    .overview-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.75rem;
        color: #7ee7f7;
        font-size: 0.92rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .overview-dot {
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 50%;
        background: #43e97b;
        box-shadow: 0 0 12px rgba(67, 233, 123, 0.8);
    }

    .overview-time {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 0.65rem;
    }

    .status-board {
        padding: 2rem;
        border-radius: 1.5rem;
        background: rgba(13, 17, 28, 0.82);
        border: 1px solid rgba(126, 231, 247, 0.12);
        box-shadow: 0 24px 60px -36px rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(12px);
    }

    .status-muted {
        color: rgba(224, 230, 237, 0.68);
    }

    .status-refresh {
        padding: 0.55rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(224, 230, 237, 0.8);
        font-size: 0.9rem;
    }

    .status-service-card {
        height: 100%;
        padding: 1.35rem;
        border-radius: 1.2rem;
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.95), rgba(18, 24, 38, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        flex-direction: column;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .status-success {
        background: rgba(67, 233, 123, 0.16);
        color: #8ef0ae;
    }

    .status-warning {
        background: rgba(255, 193, 7, 0.18);
        color: #ffd666;
    }

    .status-info {
        background: rgba(0, 180, 216, 0.18);
        color: #7ee7f7;
    }

    .status-danger {
        background: rgba(255, 91, 91, 0.18);
        color: #ff9f9f;
    }

    .status-metric-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.85rem;
        margin-top: 0.85rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .status-metric-row span {
        color: rgba(224, 230, 237, 0.7);
    }

    .status-metric-row strong {
        text-align: right;
    }

    .status-incident-text {
        max-width: 18ch;
    }

    .status-summary-copy {
        color: rgba(224, 230, 237, 0.84);
        line-height: 1.6;
        flex: 1 0 auto;
    }

    .status-source-link {
        display: inline-flex;
        margin-top: 1rem;
        color: #7ee7f7;
        text-decoration: none;
        font-weight: 600;
    }

    .status-source-link:hover {
        color: #ffffff;
    }

    body.light-mode .status-lead,
    body.light-mode .status-muted,
    body.light-mode .status-refresh,
    body.light-mode .status-metric-row span,
    body.light-mode .summary-label,
    body.light-mode .status-summary-copy {
        color: rgba(35, 42, 61, 0.72) !important;
    }

    body.light-mode .status-summary-card,
    body.light-mode .status-service-card,
    body.light-mode .status-board,
    body.light-mode .status-overview-panel {
        background: rgba(255, 255, 255, 0.92);
        border-color: rgba(0, 180, 216, 0.12);
        color: #232a3d;
    }

    body.light-mode .status-summary-card strong,
    body.light-mode .overview-time,
    body.light-mode .status-metric-row strong,
    body.light-mode .status-service-card h3,
    body.light-mode .status-board h2,
    body.light-mode .status-hero h1 {
        color: #232a3d !important;
    }

    /* Incident List Styles */
    .incidents-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .incident-card {
        padding: 1.5rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.95), rgba(18, 24, 38, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: border-color 0.3s ease;
    }

    .incident-card:hover {
        border-color: rgba(126, 231, 247, 0.3);
    }

    .incident-header {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .incident-icon {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.6rem;
        font-weight: 700;
    }

    .incident-icon.severity-critica {
        background: rgba(255, 91, 91, 0.2);
        color: #ff9f9f;
    }

    .incident-icon.severity-alta {
        background: rgba(255, 193, 7, 0.2);
        color: #ffd666;
    }

    .incident-icon.severity-media {
        background: rgba(255, 152, 0, 0.2);
        color: #ffb366;
    }

    .incident-title-section {
        flex: 1;
    }

    .incident-code-row {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.6rem;
        flex-wrap: wrap;
    }

    .incident-code {
        font-weight: 700;
        color: #7ee7f7;
        font-size: 0.95rem;
    }

    .severity-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .severity-badge.severity-critica {
        background: rgba(255, 91, 91, 0.2);
        color: #ff9f9f;
    }

    .severity-badge.severity-alta {
        background: rgba(255, 193, 7, 0.2);
        color: #ffd666;
    }

    .severity-badge.severity-media {
        background: rgba(255, 152, 0, 0.2);
        color: #ffb366;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: rgba(67, 233, 123, 0.2);
        color: #8ef0ae;
    }

    .service-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: rgba(0, 180, 216, 0.2);
        color: #7ee7f7;
    }

    .incident-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        color: #ffffff;
    }

    .incident-actions {
        flex-shrink: 0;
    }

    .btn-details {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, rgba(67, 233, 123, 0.15), rgba(0, 180, 216, 0.15));
        color: #7ee7f7;
        border: 1px solid rgba(126, 231, 247, 0.3);
        border-radius: 0.6rem;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-details:hover {
        background: linear-gradient(135deg, rgba(67, 233, 123, 0.25), rgba(0, 180, 216, 0.25));
        border-color: rgba(126, 231, 247, 0.6);
        color: #ffffff;
    }

    .incident-description {
        color: rgba(224, 230, 237, 0.84);
        line-height: 1.6;
        margin: 1rem 0 1.5rem 0;
        font-size: 0.95rem;
    }

    .incident-metadata {
        display: flex;
        gap: 2rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        flex-wrap: wrap;
    }

    .metadata-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .metadata-label {
        font-size: 0.8rem;
        color: rgba(224, 230, 237, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .metadata-value {
        color: rgba(224, 230, 237, 0.9);
        font-weight: 500;
    }

    .no-incidents-message {
        text-align: center;
        padding: 2rem;
    }

    body.light-mode .incident-card {
        background: rgba(255, 255, 255, 0.92);
        border-color: rgba(0, 180, 216, 0.12);
        color: #232a3d;
    }

    body.light-mode .incident-card:hover {
        border-color: rgba(0, 180, 216, 0.3);
    }

    body.light-mode .incident-title,
    body.light-mode .incident-code {
        color: #232a3d;
    }

    body.light-mode .incident-description,
    body.light-mode .metadata-value {
        color: rgba(35, 42, 61, 0.85);
    }

    body.light-mode .metadata-label {
        color: rgba(35, 42, 61, 0.6);
    }

    /* Modal Styles */
    .incident-modal-content {
        background: linear-gradient(180deg, rgba(24, 28, 43, 0.98), rgba(18, 24, 38, 0.99));
        border: 1px solid rgba(126, 231, 247, 0.2);
        color: rgba(224, 230, 237, 0.9);
    }

    .incident-modal-header {
        border-bottom: 1px solid rgba(126, 231, 247, 0.15);
        padding: 1.5rem;
    }

    .incident-modal-header h5 {
        margin-bottom: 0.3rem;
        color: #ffffff;
        font-size: 1.3rem;
    }

    .incident-modal-header small {
        color: rgba(224, 230, 237, 0.7);
    }

    .incident-modal-body {
        padding: 2rem;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 1.5rem;
    }

    .detail-row.full-width {
        grid-template-columns: 1fr;
    }

    .detail-col.full-width {
        grid-column: 1 / -1;
    }

    .detail-label {
        font-size: 0.8rem;
        color: rgba(224, 230, 237, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .incident-modal-body p {
        margin: 0;
        color: rgba(224, 230, 237, 0.9);
        font-size: 0.95rem;
    }

    .modal-footer {
        border-top: 1px solid rgba(126, 231, 247, 0.15);
        padding: 1rem 2rem;
    }

    .incident-modal-content .btn-close {
        filter: brightness(0.8) invert(1);
    }

    body.light-mode .incident-modal-content {
        background: rgba(255, 255, 255, 0.98);
        border-color: rgba(0, 180, 216, 0.2);
        color: rgba(35, 42, 61, 0.85);
    }

    body.light-mode .incident-modal-header {
        border-bottom-color: rgba(0, 180, 216, 0.15);
    }

    body.light-mode .incident-modal-header h5 {
        color: #232a3d;
    }

    body.light-mode .incident-modal-header small {
        color: rgba(35, 42, 61, 0.7);
    }

    body.light-mode .detail-label {
        color: rgba(35, 42, 61, 0.6);
    }

    body.light-mode .incident-modal-body p {
        color: rgba(35, 42, 61, 0.85);
    }

    .description-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .btn-translate-small {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.8rem;
        background: rgba(0, 180, 216, 0.15);
        color: #7ee7f7;
        border: 1px solid rgba(126, 231, 247, 0.3);
        border-radius: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-translate-small:hover {
        background: rgba(0, 180, 216, 0.25);
        border-color: rgba(126, 231, 247, 0.6);
        color: #ffffff;
    }

    .btn-translate-small:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-translate-small.translating {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    body.light-mode .btn-translate-small {
        background: rgba(0, 180, 216, 0.1);
        color: #0b4d6f;
        border-color: rgba(0, 180, 216, 0.3);
    }

    body.light-mode .btn-translate-small:hover {
        background: rgba(0, 180, 216, 0.2);
        border-color: rgba(0, 180, 216, 0.5);
        color: #0b4d6f;
    }

    @@media (max-width: 768px) {
        .status-board {
            padding: 1.25rem;
        }

        .status-summary-card {
            min-width: 145px;
        }

        .incident-header {
            flex-direction: column;
            gap: 1rem;
        }

        .incident-code-row {
            flex-wrap: wrap;
        }

        .incident-actions {
            width: 100%;
        }

        .btn-details {
            width: 100%;
            justify-content: center;
        }

        .incident-metadata {
            flex-direction: column;
            gap: 1rem;
        }

        .detail-row {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    /* Modal Detail Styles */
    .modal-badges {
        margin-top: 0.75rem;
    }

    .detail-value {
        margin: 0;
        color: rgba(224, 230, 237, 0.9);
        font-size: 0.95rem;
        font-weight: 500;
    }

    .detail-description-box {
        max-height: 250px;
        overflow-y: auto;
        border: 1px solid rgba(126, 231, 247, 0.2);
        padding: 1rem;
        border-radius: 0.6rem;
        background: rgba(0, 0, 0, 0.2);
        color: rgba(224, 230, 237, 0.9);
        line-height: 1.6;
        word-wrap: break-word;
        white-space: pre-wrap;
    }

    body.light-mode .detail-value {
        color: rgba(35, 42, 61, 0.85);
    }

    body.light-mode .detail-description-box {
        border-color: rgba(0, 180, 216, 0.2);
        background: rgba(0, 180, 216, 0.05);
        color: rgba(35, 42, 61, 0.85);
    }
</style>

<script>
    (() => {
        const refreshUrl = '@Url.Action("StatusSnapshot", "Home")';
        const serviceDetailBaseUrl = '@Url.Action("ServiceStatus", "Home")';
        const statusCards = document.getElementById('statusCards');
        const statusRefresh = document.getElementById('statusRefresh');
        const overviewTime = document.getElementById('overviewTime');
        const overviewText = document.getElementById('overviewText');
        const summarySources = document.getElementById('summarySources');
        const summaryHealthy = document.getElementById('summaryHealthy');
        const summaryAttention = document.getElementById('summaryAttention');

        function formatUtc(value) {
            const date = new Date(value);
            return `${date.toISOString().slice(11, 19)} UTC`;
        }

        function escapeHtml(value) {
            return value
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function renderCards(services) {
            statusCards.innerHTML = services.map(service => `
                <div class="col-md-6 col-xl-4">
                    <article class="status-service-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h5 mb-1">${escapeHtml(service.name)}</h3>
                                <p class="status-muted mb-0">Cobertura: ${escapeHtml(service.scope)}</p>
                            </div>
                            <span class="status-pill status-${escapeHtml(service.level)}">${escapeHtml(service.displayStatus)}</span>
                        </div>
                        <div class="status-metric-row">
                            <span>Fuente</span>
                            <strong>${escapeHtml(service.sourceLabel)}</strong>
                        </div>
                        <div class="status-metric-row">
                            <span>Actualizado</span>
                            <strong>${formatUtc(service.sourceUpdatedAtUtc)}</strong>
                        </div>
                        <p class="status-summary-copy mt-3 mb-0">${escapeHtml(service.summary)}</p>
                        <a class="status-source-link" href="${serviceDetailBaseUrl}?slug=${encodeURIComponent(service.slug)}">Ver detalles</a>
                    </article>
                </div>`).join('');
        }

        async function refreshStatus() {
            try {
                const response = await fetch(refreshUrl, {
                    headers: { 'X-Requested-With': 'fetch' },
                    cache: 'no-store'
                });

                if (!response.ok) {
                    return;
                }

                const snapshot = await response.json();
                summarySources.textContent = String(snapshot.services.length);
                summaryHealthy.textContent = String(snapshot.healthyCount);
                summaryAttention.textContent = String(snapshot.attentionCount);
                overviewTime.textContent = formatUtc(snapshot.lastCheckedAtUtc);
                overviewText.textContent = snapshot.overview;
                statusRefresh.textContent = `Ultimo refresh: ${new Date(snapshot.lastUpdatedAtUtc).toISOString().replace('T', ' ').slice(0, 19)} UTC`;
                renderCards(snapshot.services);
            } catch (error) {
                console.error('No se pudo actualizar el tablero de estado.', error);
            }
        }

        window.setInterval(refreshStatus, 3600000);

        // Variables globales para el modal de incidentes


        window.openIncidentModal = async function(id) {
            try {
                const response = await fetch(`/api/incidentes/${id}`, {
                    headers: { 'X-Requested-With': 'fetch' }
                });

                if (!response.ok) {
                    console.error('No se pudo cargar el incidente');
                    return;
                }

                const incidente = await response.json();

                // Traducir severidad
                const severidadMap = {
                    'Critica': 'CRÍTICA',
                    'Alta': 'ALTA',
                    'Media': 'MEDIA'
                };
                const severidadTraducida = severidadMap[incidente.severidad] || incidente.severidad;
                const severidadClass = `severity-${incidente.severidad.toLowerCase()}`;

                // Completar datos del modal
                // Traducir descripción automáticamente
                let descripcionFinal = incidente.descripcion;
                try {
                    const translateResponse = await fetch('/api/incidentes/translate', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'fetch'
                        },
                        body: JSON.stringify({
                            text: incidente.descripcion,
                            sourceLanguage: 'en',
                            targetLanguage: 'es'
                        })
                    });
                    
                    if (translateResponse.ok) {
                        const translateData = await translateResponse.json();
                        descripcionFinal = translateData.translatedText;
                    }
                } catch (error) {
                    console.warn('No se pudo traducir la descripción:', error);
                    // Se mantiene el texto original
                }

                // Actualizar header del modal
                document.getElementById('incidentModalLabel').textContent = incidente.titulo;
                document.getElementById('incidentModalSubtitle').textContent = `#${incidente.codigo}`;
                
                // Actualizar badge de severidad
                const severityBadge = document.getElementById('modalSeveridadBadge');
                severityBadge.className = `severity-badge ${severidadClass}`;
                severityBadge.textContent = severidadTraducida;

                // Actualizar badge de estado
                document.getElementById('modalEstadoBadge').textContent = 'Abierto';
                
                // Llenar los campos del modal
                document.getElementById('modalSeveridad').textContent = severidadTraducida;
                document.getElementById('modalEstado').textContent = incidente.estado || 'Abierto';
                document.getElementById('modalServicio').textContent = incidente.servicio || 'N/A';
                document.getElementById('modalFecha').textContent = incidente.fecha;
                document.getElementById('modalDescripcion').textContent = descripcionFinal;
                document.getElementById('modalProveedor').textContent = incidente.proveedor || 'N/A';
                
                // Configurar link de más información
                const urlLink = document.getElementById('modalUrlLink');
                if (incidente.urlDetalle) {
                    urlLink.href = incidente.urlDetalle;
                    urlLink.style.display = 'inline-block';
                } else {
                    urlLink.style.display = 'none';
                }

                // Mostrar modal
                const modal = new bootstrap.Modal(document.getElementById('incidentModal'));
                modal.show();
            } catch (error) {
                console.error('Error al cargar el incidente:', error);
            }
        };

        window.downloadIncidentPDF = async function() {
            const titulo = document.getElementById('incidentModalLabel').textContent || 'Incidente';
            const codigo = document.getElementById('incidentModalSubtitle').textContent || '';
            const severidad = document.getElementById('modalSeveridad').textContent || '';
            const estado = document.getElementById('modalEstado').textContent || '';
            const servicio = document.getElementById('modalServicio').textContent || '';
            const fecha = document.getElementById('modalFecha').textContent || '';
            const descripcionOriginal = document.getElementById('modalDescripcion').textContent || '';
            const proveedor = document.getElementById('modalProveedor').textContent || '';

            // Traducir la descripción al descargar el PDF
            let descripcionFinal = descripcionOriginal;
            try {
                const response = await fetch('/api/incidentes/translate', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'fetch'
                    },
                    body: JSON.stringify({
                        text: descripcionOriginal,
                        sourceLanguage: 'en',
                        targetLanguage: 'es'
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    descripcionFinal = data.translatedText || descripcionOriginal;
                }
            } catch (error) {
                console.warn('No se pudo traducir la descripción para el PDF:', error);
                // Mantiene la descripción original si falla la traducción
            }

            // Crear resumen de descripción para el PDF (primeros 500 caracteres)
            if (descripcionFinal.length > 500) {
                descripcionFinal = descripcionFinal.substring(0, 500) + '...';
            }

            const htmlContent = `
                <div style="font-family: Arial, sans-serif; padding: 10px; font-size: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; border-bottom: 3px solid #007bff; padding-bottom: 8px;">
                        <div>
                            <h1 style="color: #000; margin: 0 0 4px 0; font-size: 16px; font-weight: bold;">${titulo}</h1>
                            <p style="color: #666; margin: 0; font-size: 9px;">Código: ${codigo}</p>
                        </div>
                        <span style="background-color: #dc3545; color: white; padding: 3px 8px; border-radius: 12px; font-size: 8px; font-weight: bold;">${severidad}</span>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; table-layout: fixed;">
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Severidad:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${severidad}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Estado:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${estado}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Servicio:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${servicio}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Fecha:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${fecha}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Proveedor:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${proveedor}
                            </td>
                        </tr>
                    </table>

                    <h3 style="color: #000; margin: 8px 0 6px 0; font-size: 11px; font-weight: bold;">Descripción</h3>
                    <p style="color: #000; line-height: 1.4; white-space: pre-wrap; word-wrap: break-word; margin: 0; font-size: 9px;">${descripcionFinal}</p>

                    <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid #ccc; font-size: 8px; color: #666;">
                        <p style="margin: 2px 0;">Generado el: ${new Date().toLocaleString('es-ES')}</p>
                    </div>
                </div>
            `;

            const options = {
                margin: 10,
                filename: `incidente_${codigo.replace(/\\s+/g, '_')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' }
            };

            if (typeof html2pdf !== 'undefined') {
                html2pdf().set(options).from(htmlContent).save();
            } else {
                alert('Error: Librería de PDF no cargada. Por favor, recarga la página.');
            }
        };

        // Función para abrir el modal de detalles del servicio
        window.openServiceModal = function(service) {
            try {
                // Mapear status a clase CSS
                const statusMap = {
                    'success': 'status-success',
                    'warning': 'status-warning',
                    'danger': 'status-danger',
                    'info': 'status-info'
                };
                
                const statusClass = statusMap[service.level] || 'status-info';
                
                // Llenar los datos del modal
                document.getElementById('serviceModalLabel').textContent = service.name;
                document.getElementById('serviceModalSubtitle').textContent = service.category || 'Cloud Service';
                
                // Actualizar badge de estado
                const statusBadge = document.getElementById('modalServiceStatusBadge');
                statusBadge.className = `status-pill ${statusClass}`;
                statusBadge.textContent = service.displayStatus;
                
                // Llenar los campos del modal
                document.getElementById('modalServiceStatus').textContent = service.displayStatus;
                document.getElementById('modalServiceCategory').textContent = service.category || 'N/A';
                document.getElementById('modalServiceScope').textContent = service.scope || 'N/A';
                document.getElementById('modalServiceDays').textContent = `${service.daysWithoutIncidents} días`;
                document.getElementById('modalServiceDescription').textContent = service.summary || 'No hay descripción disponible';
                document.getElementById('modalServiceSource').textContent = service.sourceLabel || 'N/A';
                document.getElementById('modalServiceUpdated').textContent = service.sourceUpdatedAtUtc || 'N/A';
                
                // Configurar link de fuente oficial
                const urlLink = document.getElementById('modalServiceUrlLink');
                if (service.sourceUrl) {
                    urlLink.href = service.sourceUrl;
                } else {
                    urlLink.style.display = 'none';
                }
                
                // Mostrar modal
                const modal = new bootstrap.Modal(document.getElementById('serviceModal'));
                modal.show();
            } catch (error) {
                console.error('Error al cargar el servicio:', error);
                alert('No se pudo cargar los detalles del servicio');
            }
        };

        // Función para descargar el PDF del servicio
        window.downloadServicePDF = function() {
            const nombre = document.getElementById('serviceModalLabel').textContent || 'Servicio';
            const subtitle = document.getElementById('serviceModalSubtitle').textContent || '';
            const statusText = document.getElementById('modalServiceStatus').textContent || '';
            const category = document.getElementById('modalServiceCategory').textContent || '';
            const scope = document.getElementById('modalServiceScope').textContent || '';
            const days = document.getElementById('modalServiceDays').textContent || '';
            const description = document.getElementById('modalServiceDescription').textContent || '';
            const source = document.getElementById('modalServiceSource').textContent || '';
            const updated = document.getElementById('modalServiceUpdated').textContent || '';

            const htmlContent = `
                <div style="font-family: Arial, sans-serif; padding: 10px; font-size: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; border-bottom: 3px solid #007bff; padding-bottom: 8px;">
                        <div>
                            <h1 style="color: #000; margin: 0 0 4px 0; font-size: 16px; font-weight: bold;">${nombre}</h1>
                            <p style="color: #666; margin: 0; font-size: 9px;">${subtitle}</p>
                        </div>
                        <span style="background-color: #28a745; color: white; padding: 3px 8px; border-radius: 12px; font-size: 8px; font-weight: bold;">${statusText}</span>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; table-layout: fixed;">
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Estado:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${statusText}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Categoría:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${category}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Cobertura:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${scope}
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 40%; padding: 6px; border: 1px solid #ccc; background-color: #f9f9f9; color: #000; font-weight: bold; font-size: 9px;">
                                Días sin incidentes:
                            </td>
                            <td style="width: 60%; padding: 6px; border: 1px solid #ccc; color: #000; font-size: 9px;">
                                ${days}
                            </td>
                        </tr>
                    </table>

                    <h3 style="color: #000; margin: 8px 0 6px 0; font-size: 11px; font-weight: bold;">Resumen</h3>
                    <p style="color: #000; line-height: 1.4; white-space: pre-wrap; word-wrap: break-word; margin: 0; font-size: 9px;">${description}</p>

                    <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid #ccc; font-size: 8px; color: #666;">
                        <p style="margin: 2px 0;"><strong>Fuente:</strong> ${source}</p>
                        <p style="margin: 2px 0;"><strong>Actualizado:</strong> ${updated}</p>
                        <p style="margin: 2px 0;">Generado el: ${new Date().toLocaleString('es-ES')}</p>
                    </div>
                </div>
            `;

            const options = {
                margin: 10,
                filename: `servicio_${nombre.replace(/\s+/g, '_')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' }
            };

            if (typeof html2pdf !== 'undefined') {
                html2pdf().set(options).from(htmlContent).save();
            } else {
                alert('Error: Librería de PDF no cargada. Por favor, recarga la página.');
            }
        };
    })();
</script>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
}