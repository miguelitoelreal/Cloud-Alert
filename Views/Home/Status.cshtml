        flex: 1;
    }

    .incident-code-row {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.6rem;
        flex-wrap: wrap;
    }

    .incident-code {
        font-weight: 700;
        color: #7ee7f7;
        font-size: 0.95rem;
    }

    .severity-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .severity-badge.severity-critica {
        background: rgba(255, 91, 91, 0.2);
        color: #ff9f9f;
    }

    .severity-badge.severity-alta {
        background: rgba(255, 193, 7, 0.2);
        color: #ffd666;
    }

    .severity-badge.severity-media {
        background: rgba(255, 152, 0, 0.2);
        color: #ffb366;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
