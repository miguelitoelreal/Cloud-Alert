        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 1.5rem;
    }

    .detail-row.full-width {
        grid-template-columns: 1fr;
    }

    .detail-col.full-width {
        grid-column: 1 / -1;
    }

    .detail-label {
        font-size: 0.8rem;
        color: rgba(224, 230, 237, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .incident-modal-body p {
        margin: 0;
        color: rgba(224, 230, 237, 0.9);
        font-size: 0.95rem;
    }

    .modal-footer {
        border-top: 1px solid rgba(126, 231, 247, 0.15);
        padding: 1rem 2rem;
    }

    .incident-modal-content .btn-close {
        filter: brightness(0.8) invert(1);
    }

    body.light-mode .incident-modal-content {
        background: rgba(255, 255, 255, 0.98);
        border-color: rgba(0, 180, 216, 0.2);
        color: rgba(35, 42, 61, 0.85);
    }

    body.light-mode .incident-modal-header {
        border-bottom-color: rgba(0, 180, 216, 0.15);
    }

    body.light-mode .incident-modal-header h5 {
        color: #232a3d;
    }

    body.light-mode .incident-modal-header small {
        color: rgba(35, 42, 61, 0.7);
    }

