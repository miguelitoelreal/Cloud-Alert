        border-bottom: 1px solid rgba(126, 231, 247, 0.15);
        padding: 1.5rem;
    }

    .incident-modal-header h5 {
        margin-bottom: 0.3rem;
        color: #ffffff;
        font-size: 1.3rem;
    }

    .incident-modal-header small {
        color: rgba(224, 230, 237, 0.7);
    }

    .incident-modal-body {
        padding: 2rem;
    }

