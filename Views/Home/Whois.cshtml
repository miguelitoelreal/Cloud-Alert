@model CloudAlertApp.Models.WhoisLookupPageViewModel

@{
    ViewData["Title"] = "Consulta WHOIS";

    static string FormatDate(DateTimeOffset? value)
    {
        return value.HasValue
            ? value.Value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'")
            : "No disponible";
    }
}

<section class="whois-hero py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="whois-shell">
                    <div class="whois-header mb-4">
                        <span class="whois-kicker">Proteccion de servicios</span>
                        <h1 class="display-5 fw-bold mt-3 mb-3">Consultar informacion WHOIS de los servicios</h1>
                        <p class="whois-copy mb-0">Ingresa un dominio para revisar la entidad registradora, fechas clave y name servers en un formato estandarizado orientado a investigacion operativa.</p>
                    </div>

                    <form method="get" asp-controller="Home" asp-action="Whois" class="whois-form mb-4">
                        <div class="row g-3 align-items-end">
                            <div class="col-lg-9">
                                <label class="form-label whois-label" for="domain">Dominio</label>
                                <input id="domain" name="domain" class="form-control whois-input" value="@Model.DomainQuery" placeholder="ejemplo.com" autocomplete="off" />
                            </div>
                            <div class="col-lg-3 d-grid">
                                <button type="submit" class="btn btn-info whois-button text-white fw-bold">Look up</button>
                            </div>
                        </div>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning whois-alert" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (Model.Result is not null)
                    {
                        <div class="row g-4">
                            <div class="col-lg-7">
                                <section class="whois-card h-100">
                                    <div class="whois-card-header">
                                        <span class="whois-card-title">Resumen del dominio</span>
                                        <span class="whois-domain-pill">@Model.Result.DomainName</span>
                                    </div>

                                    <div class="whois-summary-grid">
                                        <div class="whois-summary-item">
                                            <span class="whois-summary-label">Entidad registradora</span>
                                            <strong>@Model.Result.RegistrarName</strong>
                                        </div>
                                        <div class="whois-summary-item">
                                            <span class="whois-summary-label">Handle</span>
                                            <strong>@(string.IsNullOrWhiteSpace(Model.Result.RegistrarHandle) ? "No disponible" : Model.Result.RegistrarHandle)</strong>
                                        </div>
                                        <div class="whois-summary-item">
                                            <span class="whois-summary-label">Registro</span>
                                            <strong>@FormatDate(Model.Result.CreatedAtUtc)</strong>
                                        </div>
                                        <div class="whois-summary-item">
                                            <span class="whois-summary-label">Vencimiento</span>
                                            <strong>@FormatDate(Model.Result.ExpiresAtUtc)</strong>
                                        </div>
                                        <div class="whois-summary-item">
                                            <span class="whois-summary-label">Ultima actualizacion</span>
                                            <strong>@FormatDate(Model.Result.UpdatedAtUtc)</strong>
                                        </div>
                                        <div class="whois-summary-item">
                                            <span class="whois-summary-label">Titular</span>
                                            <strong>@(string.IsNullOrWhiteSpace(Model.Result.RegistrantName) ? "No disponible" : Model.Result.RegistrantName)</strong>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class="col-lg-5">
                                <section class="whois-card h-100">
                                    <div class="whois-card-header">
                                        <span class="whois-card-title">Infraestructura de resolucion</span>
                                    </div>

                                    @if (Model.Result.NameServers.Count == 0)
                                    {
                                        <p class="whois-empty mb-0">No se encontraron name servers expuestos por la respuesta RDAP.</p>
                                    }
                                    else
                                    {
                                        <ul class="whois-chip-list mb-4">
                                            @foreach (var item in Model.Result.NameServers)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    }

                                    <div class="whois-card-header mt-4">
                                        <span class="whois-card-title">Estados del dominio</span>
                                    </div>

                                    @if (Model.Result.Statuses.Count == 0)
                                    {
                                        <p class="whois-empty mb-0">No se reportaron estados adicionales.</p>
                                    }
                                    else
                                    {
                                        <ul class="whois-chip-list mb-0">
                                            @foreach (var item in Model.Result.Statuses)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    }
                                </section>
                            </div>

                            <div class="col-12">
                                <section class="whois-card">
                                    <div class="whois-card-header">
                                        <span class="whois-card-title">Fuente consultada</span>
                                    </div>
                                    <a class="whois-source-link" href="@Model.Result.RdapServer" target="_blank" rel="noopener noreferrer">@Model.Result.RdapServer</a>
                                </section>
                            </div>
                        </div>
                    }
                    else if (Model.HasSearched && string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="whois-card">
                            <p class="whois-empty mb-0">La consulta no devolvio informacion util para el dominio ingresado.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .whois-shell {
        border-radius: 1.75rem;
        padding: 2rem;
        color: #e6eef7;
        background: rgba(9, 16, 31, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 28px 70px -50px rgba(0, 0, 0, 0.75);
    }

    .whois-kicker {
        display: inline-block;
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        color: #7ee7f7;
        border: 1px solid rgba(0, 230, 251, 0.3);
        background: rgba(0, 230, 251, 0.08);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.82rem;
    }

    .whois-copy,
    .whois-empty {
        color: rgba(230, 238, 247, 0.75);
    }

    .whois-label {
        color: rgba(230, 238, 247, 0.85);
        font-weight: 600;
    }

    .whois-input {
        min-height: 3.2rem;
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(15, 23, 42, 0.85);
        color: #e6eef7;
    }

    .whois-input:focus {
        color: #e6eef7;
        background: rgba(15, 23, 42, 0.95);
        border-color: rgba(0, 230, 251, 0.45);
        box-shadow: 0 0 0 0.2rem rgba(0, 230, 251, 0.12);
    }

    .whois-button {
        min-height: 3.2rem;
        border-radius: 1rem;
    }

    .whois-card {
        height: 100%;
        border-radius: 1.4rem;
        padding: 1.4rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(17, 24, 39, 0.8);
    }

    .whois-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .whois-card-title {
        font-weight: 700;
        color: #f8fafc;
    }

    .whois-domain-pill {
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        color: #8ce1ff;
        background: rgba(14, 116, 144, 0.25);
        font-size: 0.85rem;
    }

    .whois-summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .whois-summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 1rem;
        border-radius: 1rem;
        background: rgba(30, 41, 59, 0.55);
    }

    .whois-summary-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(148, 163, 184, 0.95);
    }

    .whois-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .whois-chip-list li {
        padding: 0.55rem 0.85rem;
        border-radius: 999px;
        background: rgba(15, 118, 110, 0.18);
        color: #b8fff5;
        border: 1px solid rgba(45, 212, 191, 0.18);
    }

    .whois-source-link {
        color: #7dd3fc;
        word-break: break-all;
    }

    .whois-alert {
        border-radius: 1rem;
    }

    @@media (max-width: 991.98px) {
        .whois-summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>