@model CloudAlertApp.Models.CloudServiceDetailPageViewModel

@{
    ViewData["Title"] = $"Estado de {Model.SelectedService.Name}";

    static string FormatRelativeTime(DateTimeOffset timestamp)
    {
        var elapsed = DateTimeOffset.UtcNow - timestamp.ToUniversalTime();

        if (elapsed.TotalMinutes < 1)
        {
            return "Hace menos de 1 minuto";
        }

        if (elapsed.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)Math.Floor(elapsed.TotalMinutes));
            return $"Hace {minutes} minuto{(minutes == 1 ? string.Empty : "s")}";
        }

        if (elapsed.TotalDays < 1)
        {
            var hours = Math.Max(1, (int)Math.Floor(elapsed.TotalHours));
            return $"Hace {hours} hora{(hours == 1 ? string.Empty : "s")}";
        }

        var days = Math.Max(1, (int)Math.Floor(elapsed.TotalDays));
        return $"Hace {days} dia{(days == 1 ? string.Empty : "s")}";
    }

    var verificationAge = FormatRelativeTime(Model.LastCheckedAtUtc);
    var selectedService = Model.SelectedService;
    var statusClass = $"service-state-banner service-state-{selectedService.Level}";
    var pillClass = $"service-detail-pill service-detail-pill-{selectedService.Level}";
    var iconClass = $"service-provider-icon service-provider-icon-{selectedService.Accent}";
}

<section class="service-detail-shell py-5">
    <div class="container">
        <div class="row justify-content-center g-4">
            <div class="col-xl-11">
                <section class="@statusClass">
                    <div class="service-state-copy">
                        <span class="service-state-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" role="presentation">
                                <path d="M20 7L10.5 16.5L6 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                        </span>
                        <div>
                            <span class="service-state-label">Estado general del proveedor</span>
                            <h1 class="service-state-title mb-2">@selectedService.DisplayStatus</h1>
                            <p class="service-state-text mb-0">@Model.StatusSummary</p>
                        </div>
                    </div>
                    <div class="service-state-timestamp">
                        <span class="service-state-label">Ultima verificacion</span>
                        <strong>@verificationAge</strong>
                        <span class="service-state-note">Fuente actualizada: @selectedService.SourceUpdatedAtUtc.ToUniversalTime().ToString("HH:mm:ss") UTC</span>
                    </div>
                </section>
            </div>

            <div class="col-xl-11">
                <section class="service-hero-card">
                    <div class="service-hero-main">
                        <span class="@iconClass" aria-hidden="true">
                            <span></span>
                            <span></span>
                        </span>
                        <div>
                            <h2 class="service-hero-title mb-1">@selectedService.Name</h2>
                            <p class="service-hero-category mb-3">@selectedService.Category</p>
                            <p class="service-hero-description mb-0">@selectedService.Description</p>
                        </div>
                    </div>
                    <div class="service-hero-side">
                        <span class="@pillClass">@selectedService.DisplayStatus</span>
                        <a class="service-source-link" href="@selectedService.SourceUrl" target="_blank" rel="noopener noreferrer">Ver fuente oficial</a>
                    </div>
                </section>
            </div>

            <div class="col-xl-11">
                <section class="service-summary-board">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                        <div>
                            <h3 class="service-related-title mb-1">Tabla de resumen</h3>
                            <p class="service-empty-state mb-0">Resumen rapido del estado actual del servicio seleccionado.</p>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="service-summary-table mb-0">
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th>Dias sin incidentes</th>
                                    <th>Entorno</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="service-summary-cell service-summary-cell-status">
                                            <span class="service-summary-cell-label">Estado actual</span>
                                            <span class="@pillClass service-summary-status-pill">@selectedService.DisplayStatus</span>
                                            <span class="service-summary-cell-note">Fuente: @selectedService.SourceLabel</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="service-summary-cell service-summary-cell-metric">
                                            <span class="service-summary-cell-label">Dias sin incidentes</span>
                                            <strong class="service-summary-metric">@selectedService.DaysWithoutIncidents</strong>
                                            <span class="service-summary-cell-note">Segun el historial reciente de la fuente publica</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="service-summary-cell service-summary-cell-environment">
                                            <span class="service-summary-cell-label">Entorno</span>
                                            <strong class="service-summary-environment">@selectedService.EnvironmentLabel</strong>
                                            <span class="service-summary-cell-note">Cobertura: @selectedService.Scope</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <div class="col-xl-11">
                <section class="service-related-board">
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                        <h3 class="service-related-title mb-0">Servicios en la misma categoria</h3>
                        <span class="service-related-category">(@selectedService.Category)</span>
                    </div>

                    @if (Model.RelatedServices.Count == 0)
                    {
                        <p class="service-empty-state mb-0">No hay otros servicios relacionados registrados en esta categoria.</p>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var relatedService in Model.RelatedServices)
                            {
                                var relatedPillClass = $"service-card-pill service-card-pill-{relatedService.Level}";
                                var relatedIconClass = $"service-related-icon service-related-icon-{relatedService.Accent}";

                                <div class="col-md-6 col-lg-4">
                                    <a asp-controller="Home" asp-action="ServiceStatus" asp-route-slug="@relatedService.Slug" class="service-related-card">
                                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                            <span class="@relatedIconClass" aria-hidden="true"></span>
                                            <span class="@relatedPillClass">@relatedService.DisplayStatus</span>
                                        </div>
                                        <h4 class="service-related-name mb-1">@relatedService.Name</h4>
                                        <p class="service-related-copy mb-3">@relatedService.Description</p>
                                        <span class="service-related-link">Ver detalles</span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
</section>

<style>
    .service-detail-shell {
        color: #e6eef7;
    }

    .service-state-banner,
    .service-hero-card,
    .service-summary-board,
    .service-related-board {
        border-radius: 1.6rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(9, 16, 31, 0.82);
        box-shadow: 0 24px 60px -40px rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(12px);
    }

    .service-state-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        padding: 1.9rem 2rem;
    }

    .service-state-success {
        border-color: rgba(34, 197, 94, 0.85);
        background: linear-gradient(135deg, rgba(20, 83, 45, 0.32), rgba(8, 28, 21, 0.92));
    }

    .service-state-warning {
        border-color: rgba(245, 158, 11, 0.75);
        background: linear-gradient(135deg, rgba(133, 77, 14, 0.28), rgba(33, 24, 9, 0.92));
    }

    .service-state-danger {
        border-color: rgba(239, 68, 68, 0.72);
        background: linear-gradient(135deg, rgba(127, 29, 29, 0.3), rgba(35, 12, 12, 0.92));
    }

    .service-state-info {
        border-color: rgba(56, 189, 248, 0.72);
        background: linear-gradient(135deg, rgba(8, 47, 73, 0.28), rgba(10, 20, 34, 0.92));
    }

    .service-state-copy {
        display: flex;
        align-items: center;
        gap: 1.4rem;
    }

    .service-state-icon {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        flex-shrink: 0;
    }

    .service-state-icon svg {
        width: 40px;
        height: 40px;
    }

    .service-state-label {
        display: block;
        font-size: 0.95rem;
        color: rgba(230, 238, 247, 0.82);
    }

    .service-state-title {
        font-size: clamp(2.2rem, 5vw, 3rem);
        font-weight: 800;
        color: #ffffff;
    }

    .service-state-text,
    .service-state-note,
    .service-hero-category,
    .service-hero-description,
    .service-related-copy,
    .service-related-category,
    .service-empty-state {
        color: rgba(230, 238, 247, 0.78);
    }

    .service-state-timestamp {
        min-width: 230px;
        text-align: right;
    }

    .service-state-timestamp strong {
        display: block;
        margin-top: 0.35rem;
        font-size: 1.65rem;
        color: #ffffff;
    }

    .service-state-note {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.9rem;
    }

    .service-hero-card {
        padding: 2rem;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
    }

    .service-hero-main {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
    }

    .service-provider-icon {
        width: 84px;
        height: 84px;
        border-radius: 1.4rem;
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.55rem;
        padding: 1rem;
        flex-shrink: 0;
    }

    .service-provider-icon span {
        display: block;
        height: 9px;
        border-radius: 999px;
        border: 3px solid currentColor;
    }

    .service-provider-icon-aws {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        color: #ffffff;
    }

    .service-provider-icon-azure {
        background: linear-gradient(135deg, #2563eb, #60a5fa);
        color: #eff6ff;
    }

    .service-provider-icon-google {
        background: linear-gradient(135deg, #ef4444, #fca5a5);
        color: #fff5f5;
    }

    .service-provider-icon-cloudflare {
        background: linear-gradient(135deg, #f97316, #fb923c);
        color: #fff7ed;
    }

    .service-provider-icon-neutral {
        background: linear-gradient(135deg, #334155, #64748b);
        color: #f8fafc;
    }

    .service-hero-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        color: #ffffff;
    }

    .service-hero-category {
        font-size: 1.2rem;
    }

    .service-hero-description {
        max-width: 56ch;
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .service-hero-side {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1rem;
    }

    .service-detail-pill,
    .service-card-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .service-detail-pill-success,
    .service-card-pill-success {
        background: rgba(34, 197, 94, 0.16);
        color: #86efac;
    }

    .service-detail-pill-warning,
    .service-card-pill-warning {
        background: rgba(245, 158, 11, 0.18);
        color: #fcd34d;
    }

    .service-detail-pill-danger,
    .service-card-pill-danger {
        background: rgba(239, 68, 68, 0.18);
        color: #fca5a5;
    }

    .service-detail-pill-info,
    .service-card-pill-info {
        background: rgba(56, 189, 248, 0.18);
        color: #7dd3fc;
    }

    .service-source-link,
    .service-related-link {
        color: #dbeafe;
        text-decoration: none;
        font-weight: 600;
    }

    .service-source-link:hover,
    .service-related-card:hover .service-related-link {
        color: #ffffff;
    }

    .service-related-board {
        padding: 2rem;
    }

    .service-summary-board {
        padding: 2rem;
    }

    .service-summary-table {
        width: 100%;
        color: #e6eef7;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0 0.9rem;
        table-layout: fixed;
        --bs-table-bg: transparent;
        --bs-table-color: inherit;
        --bs-table-border-color: transparent;
    }

    .service-summary-table thead th {
        padding: 0 0.6rem 0.25rem;
        border: 0;
        background: transparent;
        color: rgba(230, 238, 247, 0.72);
        font-size: 0.88rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .service-summary-table tbody tr,
    .service-summary-table tbody td {
        background: transparent;
    }

    .service-summary-table tbody td {
        padding: 0 0.6rem;
        border: 0;
        vertical-align: stretch;
    }

    .service-summary-cell {
        height: 100%;
        min-height: 138px;
        padding: 1.25rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .service-summary-cell-status {
        border-color: rgba(56, 189, 248, 0.2);
    }

    .service-summary-cell-metric {
        border-color: rgba(99, 102, 241, 0.22);
    }

    .service-summary-cell-environment {
        border-color: rgba(34, 197, 94, 0.18);
    }

    .service-summary-cell-label {
        display: block;
        font-size: 0.84rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(230, 238, 247, 0.66);
    }

    .service-summary-status-pill {
        align-self: flex-start;
    }

    .service-summary-metric {
        font-size: clamp(2rem, 4vw, 2.8rem);
        line-height: 1;
        color: #ffffff;
    }

    .service-summary-environment {
        font-size: 1.45rem;
        line-height: 1.2;
        color: #ffffff;
    }

    .service-summary-cell-note {
        display: block;
        color: rgba(230, 238, 247, 0.72);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .service-related-title {
        font-size: 1.95rem;
        font-weight: 800;
        color: #ffffff;
    }

    .service-related-card {
        height: 100%;
        padding: 1.4rem;
        border-radius: 1.2rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        display: block;
        text-decoration: none;
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .service-related-card:hover,
    .service-related-card:focus-visible {
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.18);
        box-shadow: 0 18px 42px -34px rgba(0, 0, 0, 0.85);
        outline: none;
    }

    .service-related-icon {
        width: 64px;
        height: 64px;
        border-radius: 1rem;
        display: inline-block;
    }

    .service-related-icon-aws {
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.9), rgba(168, 85, 247, 0.9));
    }

    .service-related-icon-azure {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.9), rgba(96, 165, 250, 0.9));
    }

    .service-related-icon-google {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.9), rgba(252, 165, 165, 0.9));
    }

    .service-related-icon-cloudflare {
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.9), rgba(251, 146, 60, 0.9));
    }

    .service-related-icon-neutral {
        background: linear-gradient(135deg, rgba(51, 65, 85, 0.92), rgba(100, 116, 139, 0.92));
    }

    .service-related-name {
        font-size: 1.4rem;
        font-weight: 750;
        color: #ffffff;
    }

    @@media (max-width: 992px) {
        .service-state-banner,
        .service-hero-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .service-state-timestamp,
        .service-hero-side {
            text-align: left;
            align-items: flex-start;
            min-width: 0;
        }
    }

    @@media (max-width: 768px) {
        .service-state-banner,
        .service-hero-card,
        .service-summary-board,
        .service-related-board {
            padding: 1.35rem;
        }

        .service-summary-table {
            min-width: 640px;
        }

        .service-state-copy,
        .service-hero-main {
            flex-direction: column;
            align-items: flex-start;
        }

        .service-state-icon {
            width: 64px;
            height: 64px;
        }

        .service-provider-icon {
            width: 72px;
            height: 72px;
        }
    }

    body.light-mode .service-state-banner,
    body.light-mode .service-hero-card,
    body.light-mode .service-summary-board,
    body.light-mode .service-related-board,
    body.light-mode .service-related-card {
        background: rgba(255, 255, 255, 0.95);
        color: #1f2937;
        border-color: rgba(15, 23, 42, 0.08);
    }

    body.light-mode .service-state-title,
    body.light-mode .service-hero-title,
    body.light-mode .service-related-title,
    body.light-mode .service-related-name,
    body.light-mode .service-summary-table tbody td,
    body.light-mode .service-state-timestamp strong {
        color: #0f172a;
    }

    body.light-mode .service-state-text,
    body.light-mode .service-state-note,
    body.light-mode .service-state-label,
    body.light-mode .service-summary-table thead th,
    body.light-mode .service-summary-cell-label,
    body.light-mode .service-summary-cell-note,
    body.light-mode .service-hero-category,
    body.light-mode .service-hero-description,
    body.light-mode .service-related-copy,
    body.light-mode .service-related-category,
    body.light-mode .service-empty-state {
        color: rgba(15, 23, 42, 0.74);
    }

    body.light-mode .service-related-link,
    body.light-mode .service-source-link {
        color: #1d4ed8;
    }

    body.light-mode .service-summary-cell {
        background: linear-gradient(180deg, rgba(241, 245, 249, 0.95), rgba(255, 255, 255, 0.98));
        border-color: rgba(15, 23, 42, 0.08);
        box-shadow: 0 16px 30px -24px rgba(15, 23, 42, 0.15);
    }

    body.light-mode .service-summary-metric,
    body.light-mode .service-summary-environment {
        color: #0f172a;
    }
}</style>