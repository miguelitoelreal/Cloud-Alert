@model CloudAlertApp.Models.ServiceNotificationsPageViewModel

@{
    ViewData["Title"] = "Notificaciones por servicio";
}

<style>
    .notify-shell {
        --notify-surface: linear-gradient(180deg, rgba(20, 28, 48, 0.94), rgba(13, 18, 34, 0.98));
        --notify-surface-soft: linear-gradient(180deg, rgba(18, 25, 43, 0.88), rgba(12, 18, 32, 0.94));
        --notify-border: rgba(0, 230, 251, 0.18);
        --notify-border-strong: rgba(0, 230, 251, 0.38);
        --notify-text: #e0e6ed;
        --notify-text-muted: rgba(224, 230, 237, 0.72);
        --notify-accent: #00e6fb;
        --notify-shadow: 0 30px 80px -48px rgba(0, 230, 251, 0.28);
        max-width: 1140px;
        margin: 2rem auto 4rem;
    }

    .notify-card {
        background: var(--notify-surface);
        border: 1px solid var(--notify-border);
        border-radius: 1.75rem;
        box-shadow: var(--notify-shadow);
        padding: 2rem;
        color: var(--notify-text);
    }

    .notify-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .notify-icon {
        width: 3.9rem;
        height: 3.9rem;
        border-radius: 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #00e6fb 0%, #005bea 100%);
        color: #fff;
        box-shadow: 0 18px 36px -24px rgba(0, 230, 251, 0.65);
    }

    .notify-title {
        margin: 0;
        font-size: clamp(1.8rem, 3vw, 2.3rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .notify-subtitle {
        margin: 0.35rem 0 0;
        font-size: 1.12rem;
        color: var(--notify-text-muted);
    }

    .notify-service-box {
        border: 2px dashed rgba(0, 230, 251, 0.25);
        border-radius: 1.5rem;
        padding: 1.9rem;
        background: var(--notify-surface-soft);
    }

    .notify-box-title {
        margin: 0 0 1.1rem;
        font-size: 1.1rem;
        font-weight: 800;
        color: #f8fbff;
    }

    .notify-add-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.95rem;
        align-items: center;
    }

    .notify-select {
        width: 100%;
        min-height: 3.6rem;
        border-radius: 1.1rem;
        border: 2px solid var(--notify-border-strong);
        background: rgba(7, 12, 24, 0.82);
        color: var(--notify-text);
        padding: 0 1.15rem;
        font-size: 1.05rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03), 0 12px 22px -22px rgba(0, 230, 251, 0.55);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .notify-select option {
        background: #101827;
        color: #e0e6ed;
    }

    .notify-select:focus {
        outline: none;
        border-color: var(--notify-accent);
        box-shadow: 0 0 0 4px rgba(0, 230, 251, 0.14);
    }

    .notify-add-btn,
    .notify-save-btn,
    .notify-remove-btn {
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, opacity 0.2s ease;
    }

    .notify-add-btn {
        min-width: 10.5rem;
        min-height: 3.25rem;
        border-radius: 1rem;
        padding: 0 1.25rem;
        background: rgba(148, 163, 184, 0.18);
        color: rgba(224, 230, 237, 0.55);
        font-size: 1rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        border: 1px solid rgba(148, 163, 184, 0.12);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .notify-add-btn:hover:not(:disabled),
    .notify-save-btn:hover:not(:disabled),
    .notify-remove-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 30px -18px rgba(0, 230, 251, 0.45);
    }

    .notify-add-btn:disabled,
    .notify-save-btn:disabled {
        cursor: not-allowed;
        opacity: 0.82;
    }

    .notify-add-btn.is-ready {
        background: linear-gradient(135deg, rgba(0, 230, 251, 0.2) 0%, rgba(0, 91, 234, 0.34) 100%);
        color: #eafcff;
        box-shadow: 0 14px 24px -20px rgba(0, 230, 251, 0.8);
    }

    .notify-selected-list {
        margin-bottom: 1.6rem;
        display: grid;
        gap: 1rem;
    }

    .notify-placeholder {
        border-radius: 1.2rem;
        padding: 1.1rem 1.2rem;
        background: rgba(0, 230, 251, 0.06);
        border: 1px solid rgba(0, 230, 251, 0.1);
        color: var(--notify-text-muted);
        font-size: 0.98rem;
    }

    .notify-service-item {
        border-radius: 1.45rem;
        padding: 1.5rem;
        background: rgba(8, 15, 29, 0.88);
        border: 1px solid rgba(0, 230, 251, 0.16);
        box-shadow: 0 16px 38px -34px rgba(0, 230, 251, 0.4);
    }

    .notify-service-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .notify-service-head {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .notify-service-badge {
        width: 3rem;
        height: 3rem;
        border-radius: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #00e6fb 0%, #005bea 100%);
        box-shadow: 0 14px 28px -18px rgba(0, 230, 251, 0.75);
        flex: 0 0 auto;
    }

    .notify-service-id {
        display: block;
        margin-top: 0.2rem;
        color: var(--notify-text-muted);
        font-size: 0.92rem;
    }

    .notify-status-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 0.65rem;
        flex-wrap: wrap;
    }

    .notify-status-label {
        color: var(--notify-text-muted);
        font-size: 0.88rem;
        letter-spacing: 0.01em;
    }

    .notify-status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 1.9rem;
        padding: 0.2rem 0.75rem;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.2);
        background: rgba(148, 163, 184, 0.16);
        color: #e2e8f0;
        font-size: 0.84rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .notify-status-pill.notify-status-success {
        background: rgba(34, 197, 94, 0.18);
        border-color: rgba(34, 197, 94, 0.32);
        color: #86efac;
    }

    .notify-status-pill.notify-status-warning {
        background: rgba(245, 158, 11, 0.18);
        border-color: rgba(245, 158, 11, 0.32);
        color: #fcd34d;
    }

    .notify-status-pill.notify-status-danger {
        background: rgba(248, 113, 113, 0.18);
        border-color: rgba(248, 113, 113, 0.32);
        color: #fda4af;
    }

    .notify-status-pill.notify-status-info {
        background: rgba(56, 189, 248, 0.16);
        border-color: rgba(56, 189, 248, 0.26);
        color: #7dd3fc;
    }

    .notify-config-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 0.92fr);
        gap: 1.5rem;
        align-items: start;
    }

    .notify-field-label {
        display: block;
        margin-bottom: 0.7rem;
        font-size: 0.98rem;
        font-weight: 700;
        color: #f8fbff;
    }

    .notify-frequency-select {
        width: 100%;
        min-height: 3.35rem;
        border-radius: 1rem;
        border: 1px solid rgba(0, 230, 251, 0.18);
        background: rgba(7, 12, 24, 0.82);
        color: var(--notify-text);
        padding: 0 1rem;
        font-size: 1rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    }

    .notify-frequency-select:focus {
        outline: none;
        border-color: var(--notify-accent);
        box-shadow: 0 0 0 4px rgba(0, 230, 251, 0.12);
    }

    .notify-frequency-select option {
        background: #101827;
        color: #e0e6ed;
    }

    .notify-incidents {
        display: grid;
        gap: 0.8rem;
        padding-top: 0.15rem;
    }

    .notify-check {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--notify-text);
        font-size: 1rem;
    }

    .notify-check input {
        width: 1.15rem;
        height: 1.15rem;
        accent-color: #7c3aed;
        cursor: pointer;
        margin: 0;
    }

    .notify-check-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.25rem;
        color: #facc15;
    }

    .notify-check-icon.is-incident {
        color: #ff5b6e;
    }

    .notify-summary {
        margin-top: 1.2rem;
        border-radius: 1rem;
        padding: 0.95rem 1rem;
        background: rgba(0, 230, 251, 0.08);
        border: 1px solid rgba(0, 230, 251, 0.14);
        color: #bfefff;
        line-height: 1.5;
    }

    .notify-summary strong {
        color: #f8fbff;
    }

    .notify-service-item strong {
        display: block;
        font-size: 1.02rem;
        color: #f8fbff;
    }

    .notify-service-item span {
        color: var(--notify-text-muted);
        font-size: 0.92rem;
    }

    .notify-remove-btn {
        width: 2.8rem;
        height: 2.8rem;
        border-radius: 0.95rem;
        background: rgba(0, 230, 251, 0.08);
        color: var(--notify-accent);
        font-size: 1.25rem;
        font-weight: 700;
        border: 1px solid rgba(0, 230, 251, 0.12);
    }

    .notify-footer {
        margin-top: 2.4rem;
        display: flex;
        justify-content: flex-end;
    }

    .notify-save-btn {
        min-width: 17rem;
        min-height: 3.8rem;
        padding: 0 1.6rem;
        border-radius: 1.15rem;
        background: linear-gradient(135deg, #00e6fb 0%, #005bea 100%);
        color: #fff;
        font-size: 1.15rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        box-shadow: 0 24px 48px -28px rgba(0, 230, 251, 0.58);
    }

    .notify-save-btn:disabled {
        background: linear-gradient(135deg, rgba(0, 180, 216, 0.35) 0%, rgba(0, 91, 234, 0.45) 100%);
        box-shadow: none;
    }

    .notify-meta {
        margin-top: 1rem;
        color: var(--notify-text-muted);
        font-size: 0.92rem;
    }

    .notify-toast {
        margin-top: 1rem;
        padding: 0.9rem 1rem;
        border-radius: 1rem;
        background: rgba(0, 230, 251, 0.09);
        border: 1px solid rgba(0, 230, 251, 0.16);
        color: #8ff6ff;
        font-weight: 600;
        display: none;
    }

    body.light-mode .notify-shell {
        --notify-surface: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(241, 245, 249, 0.98));
        --notify-surface-soft: linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(255, 255, 255, 0.98));
        --notify-border: rgba(0, 180, 216, 0.18);
        --notify-border-strong: rgba(0, 180, 216, 0.42);
        --notify-text: #0f172a;
        --notify-text-muted: #475569;
        --notify-shadow: 0 30px 80px -48px rgba(15, 23, 42, 0.16);
    }

    body.light-mode .notify-service-box {
        border-color: rgba(0, 180, 216, 0.22);
    }

    body.light-mode .notify-select {
        background: #fff;
        box-shadow: 0 12px 22px -22px rgba(0, 180, 216, 0.38);
    }

    body.light-mode .notify-select option {
        background: #ffffff;
        color: #0f172a;
    }

    body.light-mode .notify-add-btn {
        background: #d9e2ec;
        color: #64748b;
        border-color: rgba(148, 163, 184, 0.16);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }

    body.light-mode .notify-add-btn.is-ready {
        background: linear-gradient(135deg, #d7f8ff 0%, #bfe8ff 100%);
        color: #0369a1;
    }

    body.light-mode .notify-placeholder {
        background: rgba(0, 180, 216, 0.08);
        border-color: rgba(0, 180, 216, 0.12);
    }

    body.light-mode .notify-service-item {
        background: #ffffff;
        border-color: rgba(0, 180, 216, 0.15);
        box-shadow: 0 16px 38px -34px rgba(0, 180, 216, 0.3);
    }

    body.light-mode .notify-frequency-select {
        background: #ffffff;
        color: #0f172a;
        border-color: rgba(0, 180, 216, 0.18);
    }

    body.light-mode .notify-frequency-select option {
        background: #ffffff;
        color: #0f172a;
    }

    body.light-mode .notify-service-item strong,
    body.light-mode .notify-box-title,
    body.light-mode .notify-field-label,
    body.light-mode .notify-check {
        color: #0f172a;
    }

    body.light-mode .notify-remove-btn {
        background: rgba(0, 180, 216, 0.08);
        color: #0284c7;
        border-color: rgba(0, 180, 216, 0.12);
    }

    body.light-mode .notify-toast {
        background: rgba(0, 180, 216, 0.1);
        border-color: rgba(0, 180, 216, 0.16);
        color: #0369a1;
    }

    body.light-mode .notify-summary {
        background: rgba(0, 180, 216, 0.08);
        border-color: rgba(0, 180, 216, 0.14);
        color: #0369a1;
    }

    body.light-mode .notify-summary strong {
        color: #0f172a;
    }

    body.light-mode .notify-status-pill {
        background: rgba(148, 163, 184, 0.12);
        border-color: rgba(148, 163, 184, 0.18);
        color: #334155;
    }

    body.light-mode .notify-status-pill.notify-status-success {
        background: rgba(34, 197, 94, 0.12);
        border-color: rgba(34, 197, 94, 0.22);
        color: #15803d;
    }

    body.light-mode .notify-status-pill.notify-status-warning {
        background: rgba(245, 158, 11, 0.12);
        border-color: rgba(245, 158, 11, 0.22);
        color: #b45309;
    }

    body.light-mode .notify-status-pill.notify-status-danger {
        background: rgba(248, 113, 113, 0.12);
        border-color: rgba(248, 113, 113, 0.22);
        color: #be123c;
    }

    body.light-mode .notify-status-pill.notify-status-info {
        background: rgba(56, 189, 248, 0.12);
        border-color: rgba(56, 189, 248, 0.22);
        color: #0369a1;
    }

    @@media (max-width: 767.98px) {
        .notify-card {
            padding: 1.35rem;
            border-radius: 1.35rem;
        }

        .notify-header {
            align-items: flex-start;
        }

        .notify-add-row {
            grid-template-columns: 1fr;
        }

        .notify-add-btn,
        .notify-save-btn {
            width: 100%;
        }

        .notify-footer {
            justify-content: stretch;
        }

        .notify-service-item {
            align-items: flex-start;
        }

        .notify-service-top,
        .notify-service-head {
            align-items: flex-start;
        }

        .notify-config-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container notify-shell">
    <section class="notify-card">
        <div class="notify-header">
            <div class="notify-icon" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.8" />
                    <path d="M8 9H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M8 15H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <circle cx="9" cy="9" r="1" fill="currentColor" />
                    <circle cx="9" cy="15" r="1" fill="currentColor" />
                </svg>
            </div>
            <div>
                <h1 class="notify-title">Notificaciones por Servicio</h1>
                <p class="notify-subtitle">Configura alertas individuales para cada servicio</p>
            </div>
        </div>

        <div id="selectedServices" class="notify-selected-list">
            <div id="emptyState" class="notify-placeholder">Aun no has agregado servicios para notificar.</div>
        </div>

        <div class="notify-service-box">
            <h2 class="notify-box-title">Agregar Servicio</h2>
            <div class="notify-add-row">
                <select id="serviceSelect" class="notify-select" @(Model.AvailableServices.Any() ? null : "disabled")>
                    <option value="">Seleccionar servicio...</option>
                    @foreach (var service in Model.AvailableServices)
                    {
                        var serviceStatus = Model.ServiceStatuses.TryGetValue(service, out var currentStatus)
                            ? currentStatus
                            : new CloudAlertApp.Models.ServiceNotificationStatusViewModel();

                        <option value="@service"
                                data-status="@serviceStatus.DisplayStatus"
                                data-level="@serviceStatus.Level">@service</option>
                    }
                </select>

                <button type="button" id="addServiceButton" class="notify-add-btn" disabled>
                    <span aria-hidden="true">+</span>
                    <span>Agregar</span>
                </button>
            </div>

            <div class="notify-meta">
                @if (Model.AvailableServices.Any())
                {
                    <span>Servicios detectados desde @Model.RegisteredClientsCount cliente(s) registrados.</span>
                }
                else
                {
                    <span>No hay servicios disponibles todavía. Registra clientes primero para poder notificarlos.</span>
                }
            </div>
        </div>

        <div id="saveFeedback" class="notify-toast">Configuracion lista para guardar.</div>

        <div class="notify-footer">
            <button type="button" id="saveButton" class="notify-save-btn" disabled>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M5 4.75A1.75 1.75 0 0 1 6.75 3h7.629c.464 0 .91.184 1.238.512l2.871 2.871c.328.328.512.774.512 1.238v9.629A1.75 1.75 0 0 1 17.25 19H6.75A1.75 1.75 0 0 1 5 17.25V4.75Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M8 7.5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M8 13h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <span>Guardar Cambios</span>
            </button>
        </div>
    </section>
</div>

<script>
    (() => {
        const serviceSelect = document.getElementById('serviceSelect');
        const addServiceButton = document.getElementById('addServiceButton');
        const selectedServices = document.getElementById('selectedServices');
        const emptyState = document.getElementById('emptyState');
        const saveButton = document.getElementById('saveButton');
        const saveFeedback = document.getElementById('saveFeedback');
        const selected = new Set();

        if (!serviceSelect || !addServiceButton || !selectedServices || !emptyState || !saveButton || !saveFeedback) {
            return;
        }

        function refreshActions() {
            const hasSelection = Boolean(serviceSelect.value) && !selected.has(serviceSelect.value);
            addServiceButton.disabled = !hasSelection;
            addServiceButton.classList.toggle('is-ready', hasSelection);
            saveButton.disabled = selected.size === 0;
            emptyState.style.display = selected.size === 0 ? 'block' : 'none';
        }

        function slugifyServiceName(serviceName) {
            return serviceName
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/(^-|-$)/g, '');
        }

        function getFrequencyLabel(value) {
            const labels = {
                realtime: 'tiempo real',
                hourly: 'cada hora',
                daily: 'diario',
                weekly: 'semanal',
                monthly: 'mensual'
            };

            return labels[value] || 'diario';
        }

        function getIncidentSummary(incidentCheckbox, degradedCheckbox) {
            const selections = [];

            if (incidentCheckbox.checked) {
                selections.push('incidencias');
            }

            if (degradedCheckbox.checked) {
                selections.push('degradados');
            }

            if (selections.length === 0) {
                return 'sin tipos de incidencias seleccionados';
            }

            if (selections.length === 2) {
                return 'incidencias y degradados';
            }

            return selections[0];
        }

        function updateSummary(item) {
            const frequencySelect = item.querySelector('.notify-frequency-select');
            const incidentCheckbox = item.querySelector('[data-incident="incidents"]');
            const degradedCheckbox = item.querySelector('[data-incident="degraded"]');
            const summary = item.querySelector('.notify-summary-text');
            const frequencyText = getFrequencyLabel(frequencySelect.value);
            const incidentsText = getIncidentSummary(incidentCheckbox, degradedCheckbox);

            summary.textContent = `Recibiras notificaciones ${frequencyText} sobre ${incidentsText}.`;
        }

        function buildServiceItem(serviceName, serviceStatus, serviceLevel) {
            const item = document.createElement('div');
            item.className = 'notify-service-item';
            item.dataset.service = serviceName;
            const serviceId = slugifyServiceName(serviceName);
            const badgeLevel = serviceLevel || 'info';
            const badgeStatus = serviceStatus || 'Sin estado disponible';
            item.innerHTML = `
                <div class="notify-service-top">
                    <div class="notify-service-head">
                        <div class="notify-service-badge" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.8" />
                                <path d="M8 9H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                <path d="M8 15H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div>
                            <strong>${serviceName}</strong>
                            <span class="notify-service-id">ID: ${serviceId}</span>
                            <div class="notify-status-row">
                                <span class="notify-status-label">Estado actual:</span>
                                <span class="notify-status-pill notify-status-${badgeLevel}">${badgeStatus}</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="notify-remove-btn" aria-label="Quitar ${serviceName}">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M4 7H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M9 11V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M15 11V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M6 7L7 19C7.06 19.73 7.67 20.29 8.4 20.29H15.6C16.33 20.29 16.94 19.73 17 19L18 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M9 7V5.6C9 5.27 9.27 5 9.6 5H14.4C14.73 5 15 5.27 15 5.6V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="notify-config-grid">
                    <div>
                        <label class="notify-field-label" for="frequency-${serviceId}">Frecuencia de Notificaciones</label>
                        <select id="frequency-${serviceId}" class="notify-frequency-select">
                            <option value="realtime">Tiempo real</option>
                            <option value="hourly">Cada hora</option>
                            <option value="daily" selected>Diario</option>
                            <option value="weekly">Semanal</option>
                            <option value="monthly">Mensual</option>
                        </select>
                    </div>
                    <div>
                        <span class="notify-field-label">Tipos de Incidencias</span>
                        <div class="notify-incidents">
                            <label class="notify-check">
                                <input type="checkbox" data-incident="incidents" checked>
                                <span class="notify-check-icon is-incident" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
                                        <path d="M9.5 9.5L14.5 14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                        <path d="M14.5 9.5L9.5 14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <span>Incidencias</span>
                            </label>
                            <label class="notify-check">
                                <input type="checkbox" data-incident="degraded">
                                <span class="notify-check-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M12 4L20 19H4L12 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                                        <path d="M12 9V13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                        <circle cx="12" cy="16.5" r="1" fill="currentColor"/>
                                    </svg>
                                </span>
                                <span>Degradados</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="notify-summary">
                    <strong>Resumen:</strong>
                    <span class="notify-summary-text">Recibiras notificaciones diario sobre incidencias.</span>
                </div>
            `;

            const frequencySelect = item.querySelector('.notify-frequency-select');
            const incidentCheckbox = item.querySelector('[data-incident="incidents"]');
            const degradedCheckbox = item.querySelector('[data-incident="degraded"]');

            frequencySelect.addEventListener('change', () => {
                updateSummary(item);
                saveFeedback.style.display = 'none';
            });

            incidentCheckbox.addEventListener('change', () => {
                updateSummary(item);
                saveFeedback.style.display = 'none';
            });

            degradedCheckbox.addEventListener('change', () => {
                updateSummary(item);
                saveFeedback.style.display = 'none';
            });

            item.querySelector('.notify-remove-btn').addEventListener('click', () => {
                selected.delete(serviceName);
                item.remove();
                saveFeedback.style.display = 'none';
                refreshActions();
            });

            return item;
        }

        serviceSelect.addEventListener('change', refreshActions);

        addServiceButton.addEventListener('click', () => {
            const serviceName = serviceSelect.value;
            if (!serviceName || selected.has(serviceName)) {
                refreshActions();
                return;
            }

            const selectedOption = serviceSelect.options[serviceSelect.selectedIndex];
            const serviceStatus = selectedOption?.dataset.status || 'Sin estado disponible';
            const serviceLevel = selectedOption?.dataset.level || 'info';

            selected.add(serviceName);
            selectedServices.appendChild(buildServiceItem(serviceName, serviceStatus, serviceLevel));
            serviceSelect.value = '';
            saveFeedback.style.display = 'none';
            refreshActions();
        });

        saveButton.addEventListener('click', () => {
            if (selected.size === 0) {
                return;
            }

            const selectedList = Array.from(selected).join(', ');
            saveFeedback.textContent = `Configuracion lista para guardar para: ${selectedList}.`;
            saveFeedback.style.display = 'block';
        });

        refreshActions();
    })();
</script>