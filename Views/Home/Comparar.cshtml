@model CloudAlertApp.Models.CompareServicesPageViewModel

@{
    ViewData["Title"] = "Comparar servicios";

    static string FormatPercentage(decimal value) => $"{value:0.00}%";
    static string FormatDecimal(decimal value) => value.ToString("0.00");

    static string GetDecimalMetricTone(decimal leftValue, decimal rightValue, bool higherIsBetter = true)
    {
        if (leftValue == rightValue)
        {
            return "neutral";
        }

        var leftWins = higherIsBetter ? leftValue > rightValue : leftValue < rightValue;
        return leftWins ? "positive" : "negative";
    }

    static string GetMetricTone(int leftValue, int rightValue, bool higherIsBetter = true)
    {
        if (leftValue == rightValue)
        {
            return "neutral";
        }

        var leftWins = higherIsBetter ? leftValue > rightValue : leftValue < rightValue;
        return leftWins ? "positive" : "negative";
    }
}

<section class="compare-hero py-5">
    <div class="container">
        <div class="compare-shell">
            <div class="compare-header">
                <div>
                    <span class="compare-kicker">Analisis RSS</span>
                    <h1 class="display-6 fw-bold mt-3 mb-2">Comparar servicios cloud</h1>
                    <p class="compare-subtitle mb-0">Selecciona dos servicios monitoreados por RSS y revisa su estado, cobertura, fuente y resumen lado a lado.</p>
                </div>
                <div class="compare-timestamps">
                    <span>Snapshot: @Model.LastCheckedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                    <span>Refresh: @Model.LastUpdatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                </div>
            </div>

            <form method="get" asp-action="Comparar" asp-controller="Home" class="compare-form">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label for="left" class="form-label compare-label">Servicio 1</label>
                        <select id="left" name="left" class="form-select compare-select">
                            @foreach (var service in Model.Services)
                            {
                                <option value="@service.Slug" selected="@(service.Slug == Model.SelectedLeftSlug)">@service.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-5">
                        <label for="right" class="form-label compare-label">Servicio 2</label>
                        <select id="right" name="right" class="form-select compare-select">
                            @foreach (var service in Model.Services)
                            {
                                <option value="@service.Slug" selected="@(service.Slug == Model.SelectedRightSlug)">@service.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-2 d-grid">
                        <button type="submit" class="btn btn-info compare-submit">Comparar</button>
                    </div>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="compare-alert mt-4">@Model.ErrorMessage</div>
            }

            @if (Model.LeftService is not null && Model.RightService is not null && string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                @if (Model.LeftMetrics is not null && Model.RightMetrics is not null)
                {
                    var uptimeLeftTone = GetDecimalMetricTone(Model.LeftMetrics.UptimePercentage, Model.RightMetrics.UptimePercentage);
                    var uptimeRightTone = GetDecimalMetricTone(Model.RightMetrics.UptimePercentage, Model.LeftMetrics.UptimePercentage);
                    var slaLeftTone = GetDecimalMetricTone(Model.LeftMetrics.CurrentSlaPercentage, Model.RightMetrics.CurrentSlaPercentage);
                    var slaRightTone = GetDecimalMetricTone(Model.RightMetrics.CurrentSlaPercentage, Model.LeftMetrics.CurrentSlaPercentage);
                    var incidentDaysLeftTone = GetMetricTone(Model.LeftMetrics.DaysWithIncidents, Model.RightMetrics.DaysWithIncidents, false);
                    var incidentDaysRightTone = GetMetricTone(Model.RightMetrics.DaysWithIncidents, Model.LeftMetrics.DaysWithIncidents, false);
                    var withoutIncidentsLeftTone = GetMetricTone(Model.LeftMetrics.DaysWithoutIncidents, Model.RightMetrics.DaysWithoutIncidents);
                    var withoutIncidentsRightTone = GetMetricTone(Model.RightMetrics.DaysWithoutIncidents, Model.LeftMetrics.DaysWithoutIncidents);
                    var totalIncidentsLeftTone = GetMetricTone(Model.LeftMetrics.TotalIncidents, Model.RightMetrics.TotalIncidents, false);
                    var totalIncidentsRightTone = GetMetricTone(Model.RightMetrics.TotalIncidents, Model.LeftMetrics.TotalIncidents, false);
                    var downtimeLeftTone = GetMetricTone(Model.LeftMetrics.DowntimeMinutes, Model.RightMetrics.DowntimeMinutes, false);
                    var downtimeRightTone = GetMetricTone(Model.RightMetrics.DowntimeMinutes, Model.LeftMetrics.DowntimeMinutes, false);
                    var activeHoursLeftTone = GetDecimalMetricTone(Model.LeftMetrics.ActiveHours, Model.RightMetrics.ActiveHours);
                    var activeHoursRightTone = GetDecimalMetricTone(Model.RightMetrics.ActiveHours, Model.LeftMetrics.ActiveHours);

                    <section class="compare-metrics-board mt-4">
                        <div class="compare-metrics-header">
                            <div>
                                <h2 class="compare-metrics-title mb-1">Comparacion de metricas</h2>
                                <p class="compare-muted mb-0">Uptime, SLA, incidentes y disponibilidad calculados para los servicios seleccionados.</p>
                            </div>
                        </div>

                        <div class="compare-metrics-table">
                            <div class="compare-metrics-row compare-metrics-row-head">
                                <span class="compare-metrics-label">Metrica</span>
                                <span class="compare-metrics-column">@Model.LeftService.Name</span>
                                <span class="compare-metrics-column">@Model.RightService.Name</span>
                            </div>

                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Uptime (Tiempo Operativo)</span>
                                <span class="compare-metrics-value compare-metrics-value-@uptimeLeftTone">@FormatPercentage(Model.LeftMetrics.UptimePercentage)</span>
                                <span class="compare-metrics-value compare-metrics-value-@uptimeRightTone">@FormatPercentage(Model.RightMetrics.UptimePercentage)</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">SLA Actual</span>
                                <span class="compare-metrics-value compare-metrics-value-@slaLeftTone">@FormatPercentage(Model.LeftMetrics.CurrentSlaPercentage)</span>
                                <span class="compare-metrics-value compare-metrics-value-@slaRightTone">@FormatPercentage(Model.RightMetrics.CurrentSlaPercentage)</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Dias con Incidencias</span>
                                <span class="compare-metrics-value compare-metrics-value-@incidentDaysLeftTone">@Model.LeftMetrics.DaysWithIncidents</span>
                                <span class="compare-metrics-value compare-metrics-value-@incidentDaysRightTone">@Model.RightMetrics.DaysWithIncidents</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Dias sin Incidencias</span>
                                <span class="compare-metrics-value compare-metrics-value-@withoutIncidentsLeftTone">@Model.LeftMetrics.DaysWithoutIncidents</span>
                                <span class="compare-metrics-value compare-metrics-value-@withoutIncidentsRightTone">@Model.RightMetrics.DaysWithoutIncidents</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Total de Incidentes</span>
                                <span class="compare-metrics-value compare-metrics-value-@totalIncidentsLeftTone">@Model.LeftMetrics.TotalIncidents</span>
                                <span class="compare-metrics-value compare-metrics-value-@totalIncidentsRightTone">@Model.RightMetrics.TotalIncidents</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Tiempo de Inactividad (minutos)</span>
                                <span class="compare-metrics-value compare-metrics-value-@downtimeLeftTone">@Model.LeftMetrics.DowntimeMinutes</span>
                                <span class="compare-metrics-value compare-metrics-value-@downtimeRightTone">@Model.RightMetrics.DowntimeMinutes</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Horas de Actividad</span>
                                <span class="compare-metrics-value compare-metrics-value-@activeHoursLeftTone">@FormatDecimal(Model.LeftMetrics.ActiveHours)</span>
                                <span class="compare-metrics-value compare-metrics-value-@activeHoursRightTone">@FormatDecimal(Model.RightMetrics.ActiveHours)</span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Estado Actual</span>
                                <span class="compare-metrics-value compare-metrics-value-status">
                                    <span class="status-pill status-@Model.LeftMetrics.CurrentStatusLevel">@Model.LeftMetrics.CurrentStatus</span>
                                </span>
                                <span class="compare-metrics-value compare-metrics-value-status">
                                    <span class="status-pill status-@Model.RightMetrics.CurrentStatusLevel">@Model.RightMetrics.CurrentStatus</span>
                                </span>
                            </div>
                            <div class="compare-metrics-row">
                                <span class="compare-metrics-label">Ultimo incidente</span>
                                <span class="compare-metrics-value compare-metrics-value-neutral">@Model.LeftMetrics.LastIncidentLabel</span>
                                <span class="compare-metrics-value compare-metrics-value-neutral">@Model.RightMetrics.LastIncidentLabel</span>
                            </div>
                        </div>
                    </section>
                }
            }
        </div>
    </div>
</section>

<style>
    .compare-shell {
        padding: 2rem;
        border: 1px solid rgba(0, 230, 251, 0.14);
        border-radius: 1.5rem;
        background: rgba(10, 15, 26, 0.78);
        box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(16px);
    }

    .compare-header {
        display: flex;
        justify-content: space-between;
        gap: 1.5rem;
        align-items: flex-start;
        margin-bottom: 1.75rem;
    }

    .compare-kicker {
        display: inline-block;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: rgba(0, 230, 251, 0.08);
        color: #7ee7f7;
        border: 1px solid rgba(0, 230, 251, 0.24);
        font-size: 0.82rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .compare-subtitle,
    .compare-muted {
        color: rgba(224, 230, 237, 0.78);
    }

    .compare-timestamps {
        display: grid;
        gap: 0.45rem;
        min-width: 260px;
        padding: 1rem 1.1rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.03);
        color: #c8d3df;
        font-size: 0.92rem;
    }

    .compare-form {
        padding: 1.2rem;
        border-radius: 1.2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .compare-label {
        color: #7ee7f7;
        font-weight: 600;
    }

    .compare-select {
        border-radius: 0.9rem;
        border-color: rgba(0, 230, 251, 0.22);
        background-color: rgba(15, 23, 42, 0.75);
        color: #e0e6ed;
    }

    .compare-select:focus {
        border-color: rgba(0, 230, 251, 0.56);
        box-shadow: 0 0 0 0.2rem rgba(0, 230, 251, 0.12);
    }

    .compare-submit {
        border-radius: 0.9rem;
        font-weight: 700;
        min-height: 48px;
    }

    .compare-alert {
        padding: 1rem 1.1rem;
        border-radius: 1rem;
        background: rgba(255, 91, 91, 0.12);
        border: 1px solid rgba(255, 91, 91, 0.22);
        color: #ffd1d1;
    }

    .compare-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .compare-summary-card,
    .compare-card {
        padding: 1.25rem;
        border-radius: 1.25rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .compare-summary-label,
    .compare-metric span {
        display: block;
        color: rgba(224, 230, 237, 0.65);
        font-size: 0.88rem;
        margin-bottom: 0.3rem;
    }

    .compare-summary-card strong,
    .compare-metric strong {
        color: #fff;
    }

    .compare-card-top {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        margin-bottom: 1.25rem;
    }

    .compare-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        margin-bottom: 1rem;
    }

    .compare-metric,
    .compare-block {
        padding: 0.95rem 1rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.03);
    }

    .compare-block + .compare-block {
        margin-top: 0.85rem;
    }

    .compare-link {
        display: inline-flex;
        margin-top: 1rem;
        color: #7ee7f7;
        text-decoration: none;
        font-weight: 600;
    }

    .compare-link:hover {
        color: #00e6fb;
    }

    .compare-metrics-board {
        padding: 1.4rem;
        border-radius: 1.25rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .compare-metrics-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .compare-metrics-title {
        color: #fff;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .compare-metrics-table {
        display: grid;
        gap: 0.7rem;
    }

    .compare-metrics-row {
        display: grid;
        grid-template-columns: minmax(220px, 1.1fr) repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
        align-items: center;
    }

    .compare-metrics-row-head {
        margin-bottom: 0.15rem;
    }

    .compare-metrics-label,
    .compare-metrics-column,
    .compare-metrics-value {
        border-radius: 0.95rem;
        min-height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 1rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .compare-metrics-label {
        justify-content: flex-start;
        color: rgba(224, 230, 237, 0.82);
        font-size: 0.92rem;
        font-weight: 600;
    }

    .compare-metrics-column {
        color: #fff;
        font-weight: 700;
    }

    .compare-metrics-value {
        color: #fff;
        font-weight: 800;
    }

    .compare-metrics-value-positive {
        background: rgba(34, 197, 94, 0.12);
        border-color: rgba(74, 222, 128, 0.34);
        color: #86efac;
    }

    .compare-metrics-value-negative {
        background: rgba(248, 113, 113, 0.12);
        border-color: rgba(248, 113, 113, 0.34);
        color: #fda4af;
    }

    .compare-metrics-value-neutral {
        color: #e2e8f0;
    }

    .compare-metrics-value-status {
        background: rgba(255, 255, 255, 0.03);
    }

    .light-mode .compare-shell {
        background: rgba(255, 255, 255, 0.82);
        border-color: rgba(0, 180, 216, 0.12);
        box-shadow: 0 24px 48px -28px rgba(0, 119, 204, 0.18);
    }

    .light-mode .compare-subtitle,
    .light-mode .compare-muted,
    .light-mode .compare-summary-label,
    .light-mode .compare-metric span,
    .light-mode .compare-timestamps {
        color: rgba(35, 42, 61, 0.76);
    }

    .light-mode .compare-form,
    .light-mode .compare-summary-card,
    .light-mode .compare-card,
    .light-mode .compare-metric,
    .light-mode .compare-block,
    .light-mode .compare-timestamps,
    .light-mode .compare-metrics-board,
    .light-mode .compare-metrics-label,
    .light-mode .compare-metrics-column,
    .light-mode .compare-metrics-value {
        background: rgba(15, 23, 42, 0.04);
        border-color: rgba(15, 23, 42, 0.06);
    }

    .light-mode .compare-summary-card strong,
    .light-mode .compare-metric strong,
    .light-mode .compare-card h2,
    .light-mode .compare-card h3,
    .light-mode .compare-metrics-title,
    .light-mode .compare-metrics-column,
    .light-mode .compare-metrics-value {
        color: #232a3d;
    }

    .light-mode .compare-metrics-label {
        color: rgba(35, 42, 61, 0.82);
    }

    .light-mode .compare-metrics-value-positive {
        background: rgba(34, 197, 94, 0.12);
        border-color: rgba(34, 197, 94, 0.24);
        color: #15803d;
    }

    .light-mode .compare-metrics-value-negative {
        background: rgba(248, 113, 113, 0.12);
        border-color: rgba(248, 113, 113, 0.24);
        color: #be123c;
    }

    .light-mode .compare-select {
        background: #fff;
        color: #232a3d;
        border-color: rgba(0, 180, 216, 0.22);
    }

    @@media (max-width: 991.98px) {
        .compare-header {
            flex-direction: column;
        }

        .compare-timestamps {
            min-width: 100%;
        }

        .compare-metrics-row {
            grid-template-columns: 1fr;
        }

        .compare-metrics-label,
        .compare-metrics-column,
        .compare-metrics-value {
            justify-content: flex-start;
        }

        .compare-summary {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .compare-shell {
            padding: 1.2rem;
        }

        .compare-grid {
            grid-template-columns: 1fr;
        }

        .compare-card-top {
            flex-direction: column;
        }
    }
</style>