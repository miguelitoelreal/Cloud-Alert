@using System.Globalization
@model CloudAlertApp.Models.CostImpactViewModel

@{
    ViewData["Title"] = "Calculadora de Impacto Financiero";
    var usdCulture = CultureInfo.GetCultureInfo("en-US");
}

<div class="container py-5">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h1 class="display-6 fw-bold mb-3">Calculadora de impacto de Downtime</h1>
                    <p class="lead mb-0">Calcula el impacto financiero de las interrupciones de servici en tu negocio.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <form asp-action="CostImpact" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AnnualRevenue" class="form-label"></label>
                                <input asp-for="AnnualRevenue" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0" />
                                <span asp-validation-for="AnnualRevenue" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmployeeCount" class="form-label"></label>
                                <input asp-for="EmployeeCount" class="form-control" type="number" min="0" step="1" inputmode="numeric" placeholder="0" />
                                <span asp-validation-for="EmployeeCount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AverageHourlyCost" class="form-label"></label>
                                <input asp-for="AverageHourlyCost" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0" />
                                <span asp-validation-for="AverageHourlyCost" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IncidentDurationMinutes" class="form-label"></label>
                                <input asp-for="IncidentDurationMinutes" class="form-control" type="number" min="0" step="1" inputmode="numeric" placeholder="0" />
                                <span asp-validation-for="IncidentDurationMinutes" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InterruptionType" class="form-label"></label>
                                <select asp-for="InterruptionType" class="form-select">
                                    <option value="Total">Total</option>
                                    <option value="Parcial">Parcial</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IndustrySector" class="form-label"></label>
                                <select asp-for="IndustrySector" class="form-select">
                                    @foreach (var entry in Model.AvailableIndustryMultipliers)
                                    {
                                        <option value="@entry.Key" selected="@(entry.Key == Model.IndustrySector ? "selected" : null)">@entry.Key</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mt-4 d-flex flex-wrap gap-2">
                            <button type="submit" name="submitAction" value="Calcular" class="btn btn-primary">Calcular impacto</button>
                            <button type="submit" name="submitAction" value="Limpiar" class="btn btn-outline-secondary">Limpiar</button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.ShowResults)
            {
                <div class="card shadow-sm border-danger border-1 mb-4">
                    <div class="card-body">
                        <h3 class="fw-bold mb-3">Resultado contable (USD)</h3>
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light">
                                    <h5 class="mb-1">Pérdidas de ingresos</h5>
                                    <p class="h4 text-danger fw-bold">@Model.RevenueLoss.ToString("C2", usdCulture)</p>
                                    <small class="text-muted">Basado en ingresos anuales, duración del incidente y multiplicador del sector.</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light">
                                    <h5 class="mb-1">Pérdidas de oportunidad</h5>
                                    <p class="h4 text-danger fw-bold">@Model.OpportunityLoss.ToString("C2", usdCulture)</p>
                                    <small class="text-muted">Costo laboral durante la interrupción ajustado por tipo de incidente.</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light">
                                    <h5 class="mb-1">Costo total del incidente</h5>
                                    <p class="h4 text-danger fw-bold">@Model.TotalIncidentCost.ToString("C2", usdCulture)</p>
                                    <small class="text-muted">Suma de pérdidas de ingresos y costo de oportunidad.</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light">
                                    <h5 class="mb-1">Proyección anualizada</h5>
                                    <p class="h4 text-danger fw-bold">@Model.AnnualRiskProjection.ToString("C2", usdCulture)</p>
                                    <small class="text-muted">Transforma un incidente puntual en una métrica de riesgo anualizada.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (Model.AnnualRevenue > 0 || Model.EmployeeCount > 0 || Model.AverageHourlyCost > 0 || Model.IncidentDurationMinutes > 0)
            {
                <div class="alert alert-info">La proyección a 12 meses se mostrará cuando el costo del incidente actual sea mayor a cero.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
