@model CloudAlertApp.Models.DnsLookupResult

@{
    ViewData["Title"] = "DNS Lookup";
}

<style>
    .dns-container{
        padding:30px;
        color:white;
    }

    .dns-card{
        background:#1a1f2e;
        padding:20px;
        border-radius:12px;
        margin-top:20px;
    }

    .dns-search{
        display:flex;
        gap:10px;
    }

    .dns-search input{
        flex:1;
        padding:12px;
        border-radius:8px;
        border:none;
    }

    .dns-btn{
        background:#2563eb;
        border:none;
        padding:12px 20px;
        color:white;
        border-radius:8px;
    }

    .provider-buttons{
        margin-top:20px;
        display:flex;
        gap:10px;
    }

    .provider-btn{
        padding:10px 15px;
        border:none;
        border-radius:10px;
        cursor:pointer;
        color:white;
    }

    .aws{
        background:#ff9900;
    }

    .azure{
        background:#0078d4;
    }

    .google{
        background:#db4437;
    }

    table{
        width:100%;
        margin-top:15px;
        border-collapse:collapse;
    }

    th, td{
        border-bottom:1px solid #333;
        padding:10px;
    }

    th{
        color:#60a5fa;
    }

    .record-section{
        margin-top:30px;
    }
</style>

<div class="dns-container">

    <h1>DNS Lookup Tool</h1>

    <p>
        Consulta registros DNS para cualquier dominio.
    </p>

    <div class="dns-card">

        <form asp-action="Search" method="post">

            <div class="dns-search">

                <input
                    type="text"
                    name="domain"
                    placeholder="aws.amazon.com"
                    value="@Model.Domain"
                />

                <button class="dns-btn" type="submit">
                    🔍 Lookup
                </button>

            </div>

        </form>

        <div class="provider-buttons">

            <form asp-action="Search" method="post">
                <input type="hidden" name="domain" value="aws.amazon.com" />
                <button class="provider-btn aws">
                    ☁ AWS
                </button>
            </form>

            <form asp-action="Search" method="post">
                <input type="hidden" name="domain" value="azure.microsoft.com" />
                <button class="provider-btn azure">
                    🔵 Azure
                </button>
            </form>

            <form asp-action="Search" method="post">
                <input type="hidden" name="domain" value="cloud.google.com" />
                <button class="provider-btn google">
                    🔴 Google
                </button>
            </form>

        </div>

    </div>

    @if (!string.IsNullOrEmpty(Model.Domain))
    {
        <div class="dns-card">

            <h2>DNS Records for @Model.Domain</h2>

            @await Html.PartialAsync("_DnsTable", Model.ARecords, new ViewDataDictionary(ViewData)
            {
                ["Title"] = "A"
            })

            @await Html.PartialAsync("_DnsTable", Model.AaaaRecords, new ViewDataDictionary(ViewData)
            {
                ["Title"] = "AAAA"
            })

            @await Html.PartialAsync("_DnsTable", Model.CnameRecords, new ViewDataDictionary(ViewData)
            {
                ["Title"] = "CNAME"
            })

            @await Html.PartialAsync("_DnsTable", Model.MxRecords, new ViewDataDictionary(ViewData)
            {
                ["Title"] = "MX"
            })

            @await Html.PartialAsync("_DnsTable", Model.TxtRecords, new ViewDataDictionary(ViewData)
            {
                ["Title"] = "TXT"
            })

        </div>
    }

</div>