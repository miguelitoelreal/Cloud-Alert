{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=your_database;Username=postgres;Password=your_password"
  },
  "MonitoringEngine": {
    "GlobalIntervalSeconds": 10,
    "HttpTimeoutSeconds": 5,
    "MaxRetries": 2,
    "MaxConcurrentChecks": 4,
    "LatencyThresholdMs": 2000
  },
  "Jwt": {
    "Secret": "change-this-dev-secret-to-a-long-random-value-1234567890",
    "Issuer": "CloudAlertHub",
    "Audience": "CloudAlertHub.Frontend",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 14
  },
  "MicrosoftGraph": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "AuthorityBaseUrl": "https://login.microsoftonline.com",
    "GraphBaseUrl": "https://graph.microsoft.com/v1.0"
  },
  "CloudStatus": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "HttpTimeoutSeconds": 20,
    "Providers": [
      {
        "Name": "Cloudflare",
        "Slug": "cloudflare",
        "LogoUrl": "https://cdn.simpleicons.org/cloudflare/F38020",
        "SourceType": "StatuspageApi",
        "SourceUrl": "https://www.cloudflarestatus.com/api/v2/incidents.json",
        "StatusPageUrl": "https://www.cloudflarestatus.com",
        "IsEnabled": true
      },
      {
        "Name": "GitHub",
        "Slug": "github",
        "LogoUrl": "https://cdn.simpleicons.org/github/181717",
        "SourceType": "StatuspageApi",
        "SourceUrl": "https://www.githubstatus.com/api/v2/incidents.json",
        "StatusPageUrl": "https://www.githubstatus.com",
        "IsEnabled": true
      },
      {
        "Name": "OpenAI",
        "Slug": "openai",
        "LogoUrl": "https://cdn.simpleicons.org/openai/412991",
        "SourceType": "JsonApi",
        "SourceUrl": "https://status.openai.com/api/v2/incidents.json",
        "StatusPageUrl": "https://status.openai.com",
        "IsEnabled": true
      },
      {
        "Name": "Vercel",
        "Slug": "vercel",
        "LogoUrl": "https://cdn.simpleicons.org/vercel/000000",
        "SourceType": "StatuspageApi",
        "SourceUrl": "https://www.vercel-status.com/api/v2/incidents.json",
        "StatusPageUrl": "https://www.vercel-status.com",
        "IsEnabled": true
      },
      {
        "Name": "Twilio",
        "Slug": "twilio",
        "LogoUrl": "https://cdn.simpleicons.org/twilio/F22F46",
        "SourceType": "StatuspageApi",
        "SourceUrl": "https://status.twilio.com/api/v2/incidents.json",
        "StatusPageUrl": "https://status.twilio.com",
        "IsEnabled": true
      },
      {
        "Name": "DigitalOcean",
        "Slug": "digitalocean",
        "LogoUrl": "https://cdn.simpleicons.org/digitalocean/0080FF",
        "SourceType": "StatuspageApi",
        "SourceUrl": "https://status.digitalocean.com/api/v2/incidents.json",
        "StatusPageUrl": "https://status.digitalocean.com",
        "IsEnabled": true
      }
    ]
  },
  "Email": {
    "Enabled": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "SenderEmail": "",
    "SenderName": "Cloud Alert Hub",
    "UseSsl": true,
    "EmailProvider": "Smtp",
    "BrevoApiKey": ""
  }
}
